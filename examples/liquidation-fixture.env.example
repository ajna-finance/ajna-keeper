# Advanced Base liquidation fixture settings.
# Copy to a local env file and load it through your shell or secret manager.
# Never commit a filled copy.

# Required for live Base runs.
AJNA_AGENT_RPC_URL="https://base-mainnet.example/rpc"
AJNA_AGENT_KEEPER_KEY="0x..."
AJNA_AGENT_OUTPUT_PATH="/tmp/ajna-liquidation-fixture-summary.json"

# Helper CLI checkouts. Defaults are ../token-deployer and ../ajna-skills.
# Set these when your checkout layout differs.
# AJNA_AGENT_TOKEN_DEPLOYER_REPO="/path/to/token-deployer"
# AJNA_AGENT_AJNA_SKILLS_REPO="/path/to/ajna-skills"

# Keep live Base runs non-time-traveling.
AJNA_AGENT_ALLOW_EVM_TIME_TRAVEL="no"
AJNA_AGENT_MAX_TIME_WARPS="0"

# Set to "yes" only when you intentionally want to kick the fixture borrower.
AJNA_AGENT_FINAL_KICK="no"

# Reuse external-take contracts already configured in the keeper.
AJNA_AGENT_DEPLOY_EXTERNAL_TAKE="no"
AJNA_AGENT_KEEPER_TAKER_FACTORY_ADDRESS="0x..."
AJNA_AGENT_UNISWAP_V3_TAKER_ADDRESS="0x..."

# Choose one: strict_hybrid or fallback_regression.
AJNA_AGENT_UNISWAP_LIQUIDITY_MODE="strict_hybrid"

# Fee-tier coverage.
AJNA_AGENT_UNISWAP_FEE_TIER_TEST_MODE="all_configured"
AJNA_AGENT_UNISWAP_FEE_TIERS="3000,500,10000"
AJNA_AGENT_UNISWAP_SWAP_ROUTER_02_ADDRESS="0x2626664c2603336E57B271c5C0b26F421741e481"

# Liquidity knobs, in raw token units.
AJNA_AGENT_UNISWAP_QUOTE_LIQUIDITY_RAW="10000000000000000000000"
AJNA_AGENT_UNISWAP_COLLATERAL_LIQUIDITY_RAW="10000000000000000000000"
AJNA_AGENT_UNISWAP_WETH_LIQUIDITY_RAW="1000000000000000"
AJNA_AGENT_UNISWAP_WETH_QUOTE_LIQUIDITY_RAW="1000000000000000000000"

# Optional persistent generated actor key file. The default is ./.fixture-keys.json.
AJNA_AGENT_KEY_FILE=".fixture-keys.json"
