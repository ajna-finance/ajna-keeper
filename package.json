{
  "name": "ajna-keeper",
  "version": "0.0.1",
  "description": "keeper bot for Ajna lending protocol",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajna-finance/ajna-keeper.git"
  },
  "bugs": {
    "url": "https://github.com/ajna-finance/ajna-keeper/issues"
  },
  "homepage": "https://github.com/ajna-finance/ajna-keeper#readme",
  "scripts": {
    "start": "./node_modules/ts-node/dist/bin.js src/index.ts",
    "summarize-kick-report": "TS_NODE_TRANSPILE_ONLY=true ./node_modules/ts-node/dist/bin.js scripts/summarize-kick-report.ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts'",
    "slither": "slither . --filter-paths \"node_modules|mocks\" --exclude-informational --exclude-optimization",
    "curve-selector-canary": "./node_modules/ts-node/dist/bin.js scripts/curve-pool-selector-canary.ts",
    "check-hot-file-growth": "./node_modules/ts-node/dist/bin.js scripts/check-hot-file-growth.ts",
    "sushi-aggregator-route-canary": "./node_modules/ts-node/dist/bin.js scripts/sushi-aggregator-route-canary.ts",
    "compile": "npx hardhat compile",
    "test": "npm run typecheck && npm run unit-tests",
    "unit-tests": "TS_NODE_TRANSPILE_ONLY=true npx mocha --require ts-node/register 'tests/unit/**/*.test.ts'",
    "coverage": "TS_NODE_TRANSPILE_ONLY=true c8 --all --check-coverage=false npx mocha --require ts-node/register 'tests/unit/**/*.test.ts'",
    "coverage:check": "TS_NODE_TRANSPILE_ONLY=true c8 --all --check-coverage=true npx mocha --require ts-node/register 'tests/unit/**/*.test.ts'",
    "coverage:unit": "TS_NODE_TRANSPILE_ONLY=true c8 --temp-directory=coverage/tmp --clean=true --reporter=none --check-coverage=false npx mocha --require ts-node/register 'tests/unit/**/*.test.ts'",
    "coverage:integration": "c8 --temp-directory=coverage/tmp --clean=false --reporter=none --check-coverage=false npx hardhat test",
    "coverage:report": "c8 report --temp-directory=coverage/tmp --all --check-coverage=false",
    "coverage:merged": "npm run coverage:unit && npm run coverage:integration && npm run coverage:report",
    "integration-tests": "npx hardhat test",
    "production-verification:mainnet": "FORK_NETWORK=mainnet npx hardhat test tests/integration/production-route-selection.test.ts",
    "production-verification:base": "FORK_NETWORK=base npx hardhat test tests/integration/production-route-selection.test.ts",
    "production-verification": "npm run production-verification:mainnet && npm run production-verification:base",
    "production-verification:live-liquidity:mainnet": "RUN_LIVE_LIQUIDITY_E2E=true FORK_NETWORK=mainnet npx hardhat test tests/integration/live-liquidity-execution.test.ts",
    "production-verification:live-liquidity": "npm run production-verification:live-liquidity:mainnet",
    "create-keystore": "./node_modules/ts-node/dist/bin.js scripts/create-keystore.ts",
    "fork-base": "FORK_NETWORK=base hardhat node",
    "create-liquidatable-fixture": "./node_modules/ts-node/dist/bin.js scripts/create-liquidatable-ajna-fixture.ts",
    "create-liquidatable-uniswap-fixture": "./node_modules/ts-node/dist/bin.js scripts/create-liquidatable-ajna-fixture.ts --with-uniswap-v3-external-take",
    "oneinch-route-canary": "./node_modules/ts-node/dist/bin.js scripts/oneinch-route-canary.ts",
    "lifi-route-canary": "./node_modules/ts-node/dist/bin.js scripts/lifi-route-canary.ts",
    "verify:routes": "npm run lifi-route-canary && npm run sushi-aggregator-route-canary && npm run curve-selector-canary",
    "lifi-fork-execution-canary": "RUN_LIFI_FORK_CANARY=true HARDHAT_CHAIN_ID=8453 FORK_NETWORK=base npx hardhat test tests/integration/lifi-fork-execution-canary.test.ts",
    "check-external-take-boundaries": "./node_modules/ts-node/dist/bin.js scripts/check-external-take-boundaries.ts",
    "hybrid-fork-loop": "RUN_HYBRID_FORK_LOOP=true HARDHAT_CHAIN_ID=8453 FORK_NETWORK=base npx hardhat test tests/integration/hybrid-fork-loop.test.ts",
    "hybrid-lifi-fork-proof": "RUN_HYBRID_FORK_LOOP=true HARDHAT_CHAIN_ID=8453 FORK_NETWORK=base AJNA_AGENT_HYBRID_PATHS=calldata_aggregator AJNA_AGENT_HYBRID_LIFI_CALLBACK_PROOF=true npx hardhat test tests/integration/hybrid-fork-loop.test.ts",
    "preflight-fork-reconciliation": "RUN_PREFLIGHT_FORK=true HARDHAT_CHAIN_ID=8453 FORK_NETWORK=base npx hardhat test tests/integration/preflight-fork-reconciliation.test.ts",
    "no-spend-validation": "node scripts/run-no-spend-validation.mjs",
    "no-spend-validation:egress-guard-self-test": "node scripts/no-egress-self-test.mjs",
    "no-spend-validation:matrix": "node scripts/run-no-spend-scenario-matrix.mjs",
    "no-spend-validation:config-smoke": "node scripts/run-no-spend-validation.mjs --scenario config-loaded-discovery --run-config-smoke",
    "no-spend-validation:manual-smoke": "node scripts/run-no-spend-validation.mjs --scenario manual-direct-dex --mode manual",
    "no-spend-validation:daemon-smoke": "node scripts/run-no-spend-validation.mjs --scenario take-settlement-run-once --run-daemon-smoke --daemon-smoke-only",
    "no-spend-validation:daemon-lifecycle": "node scripts/run-no-spend-validation.mjs --scenario daemon-lifecycle --daemon-lifecycle-only",
    "high-confidence-validation": "node scripts/run-high-confidence-validation.mjs",
    "run-fixture-keeper-harness": "./node_modules/ts-node/dist/bin.js scripts/run-fixture-keeper-harness.ts"
  },
  "author": "Ajna Finance contributors",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ajna-finance/sdk": "^0.4.7",
    "@ethersproject/abstract-provider": "^5.7.0",
    "@inquirer/prompts": "^7.2.3",
    "@openzeppelin/contracts": "4.9.6",
    "@uniswap/sdk-core": "^7.5.0",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "@uniswap/v3-sdk": "^3.24.0",
    "axios": "^1.15.0",
    "ethcall": "^6.0.6",
    "ethers": "^5.7.2",
    "graphql": "^16.10.0",
    "graphql-request": "6.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.1.6",
    "winston": "^3.17.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-verify": "^2.0.13",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "6.1.2",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.10",
    "@types/sinon": "^17.0.3",
    "c8": "^11.0.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "hardhat": "^2.22.18",
    "prettier": "^3.4.2",
    "sinon": "^19.0.2",
    "typechain": "^8.1.0",
    "typescript-eslint": "^8"
  },
  "resolutions": {
    "elliptic": "^6.6.1",
    "ws": "^7.5.10",
    "@ajna-finance/sdk/**/picomatch": "^2.3.2",
    "chokidar/anymatch/picomatch": "^2.3.2",
    "chokidar/readdirp/picomatch": "^2.3.2",
    "**/typedoc/minimatch": "^9.0.7",
    "@babel/runtime": "^7.26.10",
    "elliptic/bn.js": "^4.12.3",
    "@ethersproject/bignumber/bn.js": "^5.2.3",
    "@ethersproject/signing-key/bn.js": "^5.2.3",
    "ethers/@ethersproject/bignumber/bn.js": "^5.2.3",
    "ethers/@ethersproject/signing-key/bn.js": "^5.2.3",
    "@ajna-finance/sdk/ethers/@ethersproject/bignumber/bn.js": "^5.2.3",
    "@ajna-finance/sdk/ethers/@ethersproject/signing-key/bn.js": "^5.2.3"
  }
}
