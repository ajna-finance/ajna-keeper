   149	    }
   150	
   151	    const providerQuote = await params.requestValidatedQuote({
   152	      pool: params.pool,
   153	      signer: params.signer,
   154	      config: params.config,
   155	      preparedConfig,
   156	      takerAddress,
   157	      chainId,
   158	      collateralInTokenDecimals,
   159	    });
