   438	function getConfiguredExternalTakeTaker(params: {
   439	  source: ExternalTakeLiquiditySource;
   440	  config: ExternalTakeDeploymentRuntimeConfig;
   441	}): string | undefined {
   442	  const contractKey = getExternalTakeTakerContractKeyForSource(params.source);
   443	  if (!contractKey) {
   444	    return undefined;
   445	  }
   446	
   447	  return params.config.takerContracts?.[contractKey];
