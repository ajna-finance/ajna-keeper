   461	/**
   462	 * Submits a calldata-aggregator take through the configured take write
   463	 * transport: nonce queueing, buffered gas estimation, transaction
   464	 * population, freshness re-assertion before every irreversible step, and
   465	 * provider-id-aware execution telemetry.
   466	 */
   467	export async function submitCalldataAggregatorTake(params: {
   468	  factory: AggregatorTakerFactory;
   469	  takeWriteTransport: TakeWriteTransport;
   470	  poolName: string;
   471	  poolAddress: string;
   472	  borrower: string;
   473	  auctionPrice: BigNumber;
   474	  executionCollateralWad: BigNumber;
   475	  liquiditySource: LiquiditySource;
   476	  providerId: CalldataAggregatorProviderId;
   477	  label: string;
   478	  transactionTarget: string;
   479	  swapDetails: string;
   480	  routeProfitability?: RouteProfitabilityBreakdown;
   481	  approvedMinOutRaw: BigNumber;
   482	  assertFreshQuoteStillCurrent: () => void;
   483	  onQuoteConsumed?: () => void;
   484	  onSubmissionAccepted: () => void;
   485	}): Promise<void> {
   486	  await NonceTracker.queueTransaction(
   487	    params.takeWriteTransport.signer,
   488	    async (nonce: number) => {
   489	      params.assertFreshQuoteStillCurrent();
   490	      const txArgs = [
   491	        params.poolAddress,
   492	        params.borrower,
   493	        params.auctionPrice,
   494	        params.executionCollateralWad,
   495	        Number(params.liquiditySource),
   496	        params.transactionTarget,
   497	        params.swapDetails,
   498	      ] as const;
   499	      const gasLimit = await estimateGasWithBuffer(
   500	        () => params.factory.estimateGas.takeWithAtomicSwap(...txArgs),
   501	        `${params.label} Take ${params.poolName}/${params.borrower}`,
   502	        13000
   503	      );
   504	      params.assertFreshQuoteStillCurrent();
   505	      const txRequest =
   506	        await params.factory.populateTransaction.takeWithAtomicSwap(...txArgs, {
   507	          gasLimit,
   508	          nonce: nonce.toString(),
   509	        });
   510	      params.assertFreshQuoteStillCurrent();
   511	      params.onQuoteConsumed?.();
   512	      const receipt = await submitTakeTransaction(
   513	        params.takeWriteTransport,
   514	        txRequest,
   515	        params.onSubmissionAccepted
   516	      );
   517	      logTakeExecutionTelemetry({
   518	        path: 'calldata_aggregator',
   519	        providerId: params.providerId,
   520	        source: params.liquiditySource,
   521	        poolName: params.poolName,
   522	        poolAddress: params.poolAddress,
   523	        borrower: params.borrower,
   524	        receipt,
