    97	export async function evaluateCalldataAggregatorPathQuote<
    98	  TConfig extends CalldataAggregatorQuoteConfigBase,
    99	  TPreparedConfig = undefined,
   100	  TProviderQuote extends
   101	    CalldataAggregatorProviderQuote = ApprovedCalldataAggregatorQuote,
   102	>(
   103	  params: CalldataAggregatorPathQuoteEvaluationParams<
   104	    TConfig,
