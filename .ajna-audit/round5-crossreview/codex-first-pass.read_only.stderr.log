     4	import { IERC20 } from "../OneInchInterfaces.sol";
     5	import "@openzeppelin/contracts/utils/math/Math.sol";
     6	
     7	contract MockAllowanceCheckingPool {
     8	    address public immutable collateralAddress;
     9	    address public immutable quoteTokenAddress;
    10	    uint256 public immutable quoteTokenScale;
    11	    uint256 public immutable auctionPrice;
    12	    uint256 public constant collateralScale = 1e18;
    13	
    14	    error InsufficientQuoteAllowance(uint256 allowance, uint256 requiredAllowance);
    15	
    16	    constructor(
    17	        address collateralAddress_,
    18	        address quoteTokenAddress_,
    19	        uint256 quoteTokenScale_,
    20	        uint256 auctionPrice_
    21	    ) {
    22	        collateralAddress = collateralAddress_;
    23	        quoteTokenAddress = quoteTokenAddress_;
    24	        quoteTokenScale = quoteTokenScale_;
    25	        auctionPrice = auctionPrice_;
    26	    }
    27	
    28	    function take(
    29	        address,
    30	        uint256 maxAmount,
    31	        address callee,
    32	        bytes calldata
    33	    ) external returns (uint256 collateralTaken_) {
    34	        uint256 quoteDueWad = (maxAmount * auctionPrice + 1e18 - 1) / 1e18;
    35	        uint256 requiredQuoteAllowance = Math.ceilDiv(quoteDueWad, quoteTokenScale);
    36	        uint256 allowance = IERC20(quoteTokenAddress).allowance(callee, address(this));
    37	        if (allowance < requiredQuoteAllowance) {
    38	            revert InsufficientQuoteAllowance(allowance, requiredQuoteAllowance);
    39	        }
    40	
    41	        IERC20(quoteTokenAddress).transferFrom(callee, address(this), requiredQuoteAllowance);
    42	        return maxAmount;
    43	    }
    44	}

