   148	      : (params.automaticCandidateFeeTiers ??
   149	        (primaryTier !== undefined ? [primaryTier] : []));
   150	  const tiers = Array.from(
   151	    new Set([
   152	      ...(primaryTier !== undefined ? [primaryTier] : []),
   153	      ...candidateTiers,
   154	    ])
   155	  );
   156	  return params.filterInvalid ? tiers.filter(isValidV3FeeTier) : tiers;
   157	}
   158	
   159	export function formatLiquiditySource(
   160	  source: LiquiditySource | undefined
   161	): string {
   162	  return source !== undefined
   163	    ? (LiquiditySource[source] ?? String(source))
   164	    : 'n/a';
   165	}
   166	
   167	export function getTokenAddressCaseInsensitive(
   168	  addresses: { [tokenSymbol: string]: string } | undefined,
   169	  symbol: string
   170	): string | undefined {
   171	  if (!addresses) {
   172	    return undefined;
   173	  }
   174	
   175	  for (const [key, value] of Object.entries(addresses)) {
   176	    if (key.toLowerCase() === symbol.toLowerCase()) {
   177	      return value;
   178	    }
   179	  }
   180	
   181	  return undefined;
   182	}
   183	
   184	export function resolveWrappedNativeTokenAddress(
   185	  addresses: { [tokenSymbol: string]: string } | undefined
   186	): string | undefined {
   187	  for (const symbol of WRAPPED_NATIVE_TOKEN_SYMBOLS) {
   188	    const address = getTokenAddressCaseInsensitive(addresses, symbol);
   189	    if (address) {
   190	      return address;
   191	    }
   192	  }
   193	
   194	  return undefined;
   195	}
   196	
   197	export function hasConfiguredGasQuoteLiquiditySource(
   198	  config: LiquiditySourceConfig,
   199	  liquiditySource: LiquiditySource,
   200	  chainId?: number
   201	): boolean {
   202	  switch (liquiditySource) {
   203	    case LiquiditySource.ONEINCH:
   204	      return !!(
   205	        hasNonEmptyObject(config.oneInchRouters) &&
   206	        (chainId === undefined || config.oneInchRouters?.[chainId])
   207	      );
   208	    case LiquiditySource.UNISWAPV3:
   209	      return !!resolveUniswapV3DirectDexQuoteConfig(
   210	        config.uniswapV3RouterOverrides
   211	      );
   212	    case LiquiditySource.CURVE:
   213	      return !!(
   214	        hasNonEmptyObject(config.curveRouterOverrides?.poolConfigs) &&
   215	        config.curveRouterOverrides?.wethAddress
   216	      );
   217	    default:
   218	      return false;
   219	  }
   220	}
   221	
   222	export function resolveConfiguredGasQuoteLiquiditySource(
   223	  config: LiquiditySourceConfig,
   224	  chainId?: number
   225	): LiquiditySource | undefined {
   226	  const preferredSource = config.discoveredDefaults?.take?.liquiditySource;
   227	  if (
   228	    preferredSource !== undefined &&
   229	    hasConfiguredGasQuoteLiquiditySource(config, preferredSource, chainId)
   230	  ) {
   231	    return preferredSource;
   232	  }
   233	
   234	  for (const candidate of [
   235	    LiquiditySource.ONEINCH,
   236	    LiquiditySource.UNISWAPV3,
   237	    LiquiditySource.CURVE,
   238	  ]) {
   239	    if (hasConfiguredGasQuoteLiquiditySource(config, candidate, chainId)) {
   240	      return candidate;
   241	    }
   242	  }
   243	
   244	  return undefined;
   245	}
   246	
   247	export function resolveConfiguredWrappedNativeAddress(
   248	  config: LiquiditySourceConfig,
   249	  liquiditySource?: LiquiditySource
   250	): string | undefined {
   251	  if (liquiditySource === LiquiditySource.UNISWAPV3) {
   252	    return (
   253	      config.uniswapV3RouterOverrides?.wethAddress ??
   254	      resolveWrappedNativeTokenAddress(config.tokenAddresses)
   255	    );
   256	  }
   257	
   258	  if (liquiditySource === LiquiditySource.CURVE) {
   259	    return (
   260	      config.curveRouterOverrides?.wethAddress ??
   261	      resolveWrappedNativeTokenAddress(config.tokenAddresses)
   262	    );
   263	  }
   264	
   265	  return (
   266	    resolveWrappedNativeTokenAddress(config.tokenAddresses) ??
   267	    config.uniswapV3RouterOverrides?.wethAddress ??
   268	    config.curveRouterOverrides?.wethAddress
   269	  );
   270	}
   271	
   272	export function hasConfiguredWrappedNativeAddress(
   273	  config: LiquiditySourceConfig
   274	): boolean {
   275	  return resolveConfiguredWrappedNativeAddress(config) !== undefined;
   276	}

