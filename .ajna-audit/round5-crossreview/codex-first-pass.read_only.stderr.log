   213	/**
   214	 * Convert from WAD (18 decimals) to token's native decimals
   215	 * Use: When passing Ajna amounts to external DEXs
   216	 * Example: convertWadToTokenDecimals(collateral, 6) for USDC
   217	 */
   218	export function convertWadToTokenDecimals(
   219	  wadAmount: BigNumber,
   220	  tokenDecimals: number
   221	): BigNumber {
   222	  if (tokenDecimals === 18) {
   223	    return wadAmount; // No conversion needed
   224	  }
   225	
   226	  if (tokenDecimals < 18) {
   227	    // Scale down: divide by 10^(18 - tokenDecimals)
   228	    const divisor = ethers.BigNumber.from(10).pow(18 - tokenDecimals);
   229	    return wadAmount.div(divisor);
   230	  } else {
   231	    // Scale up: multiply by 10^(tokenDecimals - 18)
   232	    const multiplier = ethers.BigNumber.from(10).pow(tokenDecimals - 18);
   233	    return wadAmount.mul(multiplier);
   234	  }
   235	}
   236	
   237	/**
   238	 * Convert from WAD (18 decimals) to token's native decimals, rounding up.
   239	 * Use when the converted value is a repayment, gas, or min-out floor.
   240	 */
   241	export function convertWadToTokenDecimalsCeil(
   242	  wadAmount: BigNumber,
   243	  tokenDecimals: number
   244	): BigNumber {
   245	  if (tokenDecimals === 18) {
   246	    return wadAmount;
   247	  }
   248	
   249	  if (tokenDecimals < 18) {
   250	    const divisor = ethers.BigNumber.from(10).pow(18 - tokenDecimals);
   251	    return wadAmount.isZero()
   252	      ? ethers.BigNumber.from(0)
   253	      : wadAmount.add(divisor).sub(1).div(divisor);
   254	  }
   255	
   256	  const multiplier = ethers.BigNumber.from(10).pow(tokenDecimals - 18);
   257	  return wadAmount.mul(multiplier);
   258	}
