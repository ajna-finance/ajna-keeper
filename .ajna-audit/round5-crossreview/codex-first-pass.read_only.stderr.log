   207	      `${params.label} take check for pool ${params.pool.name}: ${[
   208	        `marketPrice=${economics.marketPrice.toFixed(6)}`,
   209	        `takeablePrice=${economics.takeablePrice.toFixed(6)}`,
   210	        `auctionPrice=${params.price.toFixed(6)}`,
   211	        `collateral=${economics.collateralAmount}`,
   212	        `factor=${params.poolConfig.take.marketPriceFactor}`,
   213	        ...providerLogFields,
