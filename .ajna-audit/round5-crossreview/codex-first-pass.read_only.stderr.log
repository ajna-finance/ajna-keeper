    72	  if (!router) {
    73	    throw new OneInchAggregatorQuoteError(
    74	      `missing 1inch router for chain ${params.chainId}`,
    75	      { retryable: false, errorCode: 'missing_router' }
    76	    );
    77	  }
    78	  return router;
    79	}
    80	
    81	function normalizeTxValue(value: unknown): string {
    82	  if (value === undefined || value === null || value === '') {
    83	    return '0';
    84	  }
    85	  return BigNumber.from(value).toString();
    86	}
    87	
    88	/**
    89	 * Fetches 1inch swap calldata for the calldata-aggregator taker and normalizes
    90	 * it into the shared aggregator quote shape. Raw 1inch responses stay inside
    91	 * this provider boundary.
    92	 */
    93	export async function requestValidatedOneInchAggregatorQuote(params: {
    94	  pool: FungiblePool;
    95	  signer: Signer;
    96	  config: OneInchAggregatorQuoteConfig;
    97	  takerAddress: string;
    98	  chainId: number;
    99	  collateralInTokenDecimals: BigNumber;
   100	}): Promise<ApprovedCalldataAggregatorQuote> {
   101	  const configuredRouter = requireOneInchRouter({
   102	    routers: params.config.oneInchRouters,
   103	    chainId: params.chainId,
   104	  });
   105	  const dexRouter = new DexRouter(params.signer, {
   106	    oneInchRouters: params.config.oneInchRouters ?? {},
   107	    connectorTokens: params.config.connectorTokens ?? [],
   108	  });
   109	  const swapData = await dexRouter.getSwapDataFromOneInch(
   110	    params.chainId,
   111	    params.collateralInTokenDecimals,
   112	    params.pool.collateralAddress,
   113	    params.pool.quoteAddress,
   114	    params.config.oneInchDefaultSlippage ?? 1,
   115	    params.takerAddress,
   116	    true,
   117	    getOneInchAggregatorRequestOptions(params.config)
   118	  );
   119	  if (!swapData.success || !swapData.data) {
   120	    throw new OneInchAggregatorQuoteError(
   121	      swapData.error ?? '1inch swap data request failed',
   122	      {
   123	        retryable: swapData.retryable,
   124	        errorCode: swapData.errorCode,
   125	      }
   126	    );
   127	  }
   128	  if (swapData.dstAmount === undefined) {
   129	    throw new OneInchAggregatorQuoteError(
   130	      '1inch swap data is missing dstAmount',
   131	      { retryable: true, errorCode: 'invalid_response' }
   132	    );
   133	  }
   134	
   135	  const swapDetails = convertSwapApiResponseToDetails(swapData.data);
   136	  const validationError = validateOneInchSwapDetailsForAtomicTake(
   137	    swapDetails,
   138	    {
   139	      srcToken: params.pool.collateralAddress,
   140	      dstToken: params.pool.quoteAddress,
   141	      srcReceiver: configuredRouter,
   142	      dstReceiver: params.takerAddress,
   143	      amount: params.collateralInTokenDecimals,
   144	      aggregationExecutors:
   145	        params.config.oneInchAggregationExecutorAllowlist?.[params.chainId],
   146	    }
   147	  );
   148	  if (validationError) {
   149	    throw new OneInchAggregatorQuoteError(validationError, {
   150	      retryable: false,
   151	      errorCode: 'route_validation',
   152	    });
   153	  }
   154	  const callData = swapData.data.data;
   155	  const routeMinOutRaw = BigNumber.from(
   156	    swapDetails.swapDescription.minReturnAmount
   157	  );
   158	
   159	  return {
   160	    providerId: 'oneinch',
   161	    quotedAtMs: Date.now(),
   162	    chainId: params.chainId,
   163	    srcToken: params.pool.collateralAddress,
   164	    dstToken: params.pool.quoteAddress,
   165	    dstReceiver: params.takerAddress,
   166	    amountInTokenUnits: params.collateralInTokenDecimals,
   167	    quoteAmountRaw: BigNumber.from(swapData.dstAmount),
   168	    routeMinOutRaw,
   169	    transactionTarget: swapData.data.to,
   170	    approvalSpender: configuredRouter,
   171	    callData,
   172	    selector: ethers.utils.hexDataSlice(callData, 0, 4),
   173	    txValue: normalizeTxValue(swapData.data.value),
   174	    routeSummary: {
   175	      providerId: 'oneinch',
   176	      tool: '1inch',
   177	      feeCosts: [],
   178	    },
   179	  };
   180	}

