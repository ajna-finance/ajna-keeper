   677	async function main() {
   678	  const args = process.argv.slice(2);
   679	
   680	  if (args.length !== 1) {
   681	    console.error(
   682	      'Usage: npx ts-node scripts/deploy-factory-system.ts <config-file-path>'
   683	    );
   684	    console.error(
   685	      'Example: npx ts-node scripts/deploy-factory-system.ts hemi-conf-settlement.ts'
   686	    );
   687	    console.error('\n Prerequisites:');
   688	    console.error('1. Compile contracts: yarn compile');
   689	    console.error('2. Have your keystore.json file ready');
   690	    console.error('3. Ensure sufficient ETH balance (recommended: >0.01 ETH)');
   691	    process.exit(1);
   692	  }
   693	
   694	  const configPath = args[0];
   695	
   696	  try {
   697	    console.log('🚀 Universal Factory System Deployment');
   698	    console.log('=====================================');
   699	
   700	    // Step 1: Load and validate configuration
   701	    console.log(`📖 Loading configuration from: ${configPath}`);
   702	    const config = await readConfigFile(configPath);
   703	    await validateConfig(config);
   704	
   705	    // Step 2: Detect chain information
   706	    const chainInfo = await detectChainInfo(config);
   707	    console.log(
   708	      `🌐 Target Network: ${chainInfo.name} (Chain ID: ${chainInfo.chainId})`
   709	    );
   710	    validateDetectedChainLifiProductionConfig(config, chainInfo);
   711	
   712	    // Step 3: Load wallet from keystore
   713	    console.log('\n🔐 Loading wallet from keystore...');
   714	    const keystoreJson = readFileSync(config.signer.keystore, 'utf8');
   715	    const pswd = await getKeystorePassword();
   716	
   717	    const wallet = await ethers.Wallet.fromEncryptedJson(keystoreJson, pswd);
   718	    console.log('👤 Loaded wallet:', wallet.address);
   719	
   720	    // Step 4: Connect to network
   721	    const provider = new ethers.providers.JsonRpcProvider(
   722	      config.network.rpcUrl
   723	    );
   724	    const deployer = wallet.connect(provider);
   725	
   726	    const balance = await deployer.getBalance();
   727	    console.log(
   728	      '💰 Account balance:',
   729	      ethers.utils.formatEther(balance),
   730	      'ETH'
   731	    );
   732	
   733	    // Balance check for Hemi - much lower gas costs
   734	    const minRequiredBalance = ethers.utils.parseEther('0.0005'); // 0.0005 ETH minimum for Hemi
   735	    if (balance.lt(minRequiredBalance)) {
   736	      console.warn('⚠️  WARNING: Low balance detected!');
   737	      console.warn('💡 You may need more ETH for deployment');
   738	    } else {
   739	      console.log('✅ Balance sufficient for Hemi deployment');
   740	    }
   741	
   742	    // Step 5: Verify network matches
   743	    const networkCheck = await provider.getNetwork();
   744	    if (networkCheck.chainId !== chainInfo.chainId) {
   745	      throw new Error(
   746	        `Network mismatch! Config suggests ${chainInfo.chainId}, connected to ${networkCheck.chainId}`
   747	      );
   748	    }
   749	
   750	    console.log('\n📋 Deployment Configuration:');
   751	    console.log(`- Network: ${chainInfo.name} (${chainInfo.chainId})`);
   752	    console.log(`- Ajna Pool Factory: ${config.ajna.erc20PoolFactory}`);
   753	    console.log(`- Deployer: ${deployer.address}`);
   754	
   755	    // Step 6: Execute deployment (CORRECT ORDER)
   756	    const addresses: DeploymentAddresses = {};
   757	
   758	    // Deploy factory FIRST
   759	    addresses.factory = await deployFactory(
   760	      deployer,
   761	      config.ajna.erc20PoolFactory,
   762	      chainInfo.chainId
   763	    );
   764	
   765	    // ADD DELAY AFTER FACTORY DEPLOYMENT
   766	    await new Promise((resolve) => setTimeout(resolve, 2000)); // 2 second delay
   767	
   768	    // Deploy Uniswap V3 taker if factory SwapRouter02 routing is configured
   769	    if (config.dex?.uniswapV3?.router) {
   770	      addresses.uniswapTaker = await deployUniswapTaker(
   771	        deployer,
   772	        config.ajna.erc20PoolFactory,
   773	        addresses.factory, // Pass factory address for authorization
   774	        chainInfo.chainId
   775	      );
   776	      // ADD DELAY AFTER UNISWAP DEPLOYMENT
   777	      await new Promise((resolve) => setTimeout(resolve, 2000)); // 2 second delay
   778	    }
   779	
   780	
   781	    // Deploy curve taker if configured
   782	    if (config.dex?.curve) {
   783	      addresses.curveTaker = await deployCurveKeeperTaker(
   784	        deployer,
   785	        config.ajna.erc20PoolFactory,
   786	        addresses.factory,
   787	        chainInfo.chainId
   788	      );
   789	      // ADD DELAY AFTER CURVE DEPLOYMENT
   790	      await new Promise((resolve) => setTimeout(resolve, 2000)); // 2 second delay
   791	    }
   792	
   793	    // Deploy LI.FI taker only for production configs. Canary configs are
   794	    // for route-shape discovery and fork validation, not live registration.
   795	    if (hasProductionLifiConfig(config)) {
   796	      addresses.lifiTaker = await deployLifiKeeperTaker(
   797	        deployer,
   798	        config.ajna.erc20PoolFactory,
   799	        addresses.factory,
   800	        chainInfo.chainId,
   801	        getGasConfig
   802	      );
   803	      // ADD DELAY AFTER LI.FI DEPLOYMENT
   804	      await new Promise((resolve) => setTimeout(resolve, 2000)); // 2 second delay
   805	    }
   806	    // ADD DELAY BEFORE CONFIGURATION
   807	    console.log('\n⏳ Waiting before configuration...');
   808	    await new Promise((resolve) => setTimeout(resolve, 3000)); // 3 second delay
   809	
   810	    // Step 7: Configure factory
   811	    if (!addresses.factory) {
   812	      throw new Error('Missing factory address for configuration');
   813	    }
   814	    await configureFactory(deployer, addresses.factory, addresses);
   815	    if (addresses.lifiTaker) {
   816	      // Configure + exactly verify the LI.FI taker allowlists FIRST, then
   817	      // register the taker in the factory. This keeps factory enablement
