    72	            details.targetToken != pool.quoteTokenAddress() ||
    73	            details.deadline <= block.timestamp ||
    74	            details.amountOutMinimum == 0 ||
    75	            plannedAmountIn == 0
    76	        ) revert InvalidSwapDetails();
    77	        _swapWithUniswapV3(
    78	            pool.collateralAddress(),
    79	            details.targetToken,
    80	            collateral,
    81	            TakerTakeScaling.quoteAmountDueCeiling(pool, quoteAmountDue),
    82	            plannedAmountIn,
