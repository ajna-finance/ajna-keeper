     2	pragma solidity 0.8.28;
     3	
     4	import { Math } from "@openzeppelin/contracts/utils/math/Math.sol";
     5	
     6	import { IERC20Pool } from "../AjnaInterfaces.sol";
     7	
     8	/// @notice Shared take-size scaling math for keeper taker contracts.
     9	/// @dev Ajna's take() may clamp the collateral actually purchased below the
    10	///      requested maxAmount on debt-constrained auctions. Keepers quote their
    11	///      output floor for the full planned size, so takers pro-rate that floor
    12	///      to the collateral Ajna actually sent. Internal functions are inlined
    13	///      by the compiler, so using this library does not change call semantics.
    14	library TakerTakeScaling {
    15	    /// @dev Planned swap input for maxAmount, in collateral token precision;
    16	    ///      the scaling basis callbacks use to pro-rate the encoded
    17	    ///      amountOutMinimum.
    18	    function plannedTakeAmount(IERC20Pool pool, uint256 maxAmount) internal view returns (uint256 plannedAmountIn) {
    19	        plannedAmountIn = maxAmount / pool.collateralScale();
    20	        require(plannedAmountIn > 0, "Zero planned amount");
    21	    }
    22	
    23	    /// @dev Pro-rates the full-size output floor to the collateral Ajna
    24	    ///      actually sent. Enforcing the unscaled floor would reject valid
    25	    ///      debt-constrained partial fills; rounding up preserves the quoted
    26	    ///      per-unit floor at any fill size, and quoteAmountDue remains a
    27	    ///      separate repayment backstop in each taker.
    28	    /// @dev MEV note: the keeper quotes fullSizeAmountOutMinimum with slippage
    29	    ///      against the FULL planned size. A partial fill has less price impact,
    30	    ///      so this linear pro-rate is a LOOSE (lower) floor than the partial
    31	    ///      fill could achieve, widening the sandwich window on a public-mempool
    32	    ///      take. This is bounded below by quoteAmountDue (the auction is always
    33	    ///      repaid; no principal loss) and is mitigated operationally by the
    34	    ///      keeper's private-RPC / relay submission. Tightening on-chain would
    35	    ///      require the partial-fill spot price, which is not available in the
    36	    ///      callback.
    37	    function scaleAmountOutMinimum(
    38	        uint256 fullSizeAmountOutMinimum,
    39	        uint256 actualAmountIn,
    40	        uint256 plannedAmountIn
    41	    ) internal pure returns (uint256) {
    42	        if (actualAmountIn == plannedAmountIn) return fullSizeAmountOutMinimum;
    43	        return Math.mulDiv(fullSizeAmountOutMinimum, actualAmountIn, plannedAmountIn, Math.Rounding.Up);
    44	    }
    45	
    46	    /// @dev Ajna's callback reports `quoteAmountDue` floor-divided to quote
    47	    ///      token precision, but the pool then pulls the ceil-divided amount
    48	    ///      from the taker (`Pool._transferQuoteTokenFrom`), which can exceed
    49	    ///      the reported due by 1 token-wei whenever quoteTokenScale > 1.
    50	    ///      Guarding against this ceiling makes the swap-output check honest:
    51	    ///      a swap that only covers the floored due would otherwise pass the
    52	    ///      taker's guard and then revert inside the pool's pull with an
    53	    ///      opaque token error.
    54	    /// @dev The +1 is unconditional because the callback cannot observe the
    55	    ///      WAD amount to detect exact division. When the division IS exact
    56	    ///      (pull == floored due) this over-asks by one token-wei, rejecting
    57	    ///      only a take whose swap output exactly equals the due — a
    58	    ///      zero-margin fill the keeper never plans for: the off-chain sizer
    59	    ///      already prices every route against the ceil-rounded due
    60	    ///      (getQuoteAmountDueRaw / "below auction repayment floor" gate).
    61	    function quoteAmountDueCeiling(IERC20Pool pool, uint256 quoteAmountDue) internal view returns (uint256) {
    62	        return pool.quoteTokenScale() > 1 ? quoteAmountDue + 1 : quoteAmountDue;
    63	    }
    64	}

