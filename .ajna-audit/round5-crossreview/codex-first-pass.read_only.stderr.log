   412	async function configureFactory(
   413	  deployer: ethers.Wallet,
   414	  factoryAddress: string,
   415	  addresses: DeploymentAddresses
   416	): Promise<void> {
   417	  console.log('\n⚙️  Step 3: Configuring factory with takers...');
   418	
   419	  const factoryArtifact = require(
   420	    path.join(
   421	      __dirname,
   422	      '..',
   423	      'artifacts',
   424	      'contracts',
   425	      'factories',
   426	      'TakerRouter.sol',
   427	      'TakerRouter.json'
   428	    )
   429	  );
   430	  const factory = new ethers.Contract(
   431	    factoryAddress,
   432	    factoryArtifact.abi,
   433	    deployer
   434	  );
   435	
   436	  // Register UniswapV3 taker (LiquiditySource.UNISWAPV3 = 2)
   437	  if (addresses.uniswapTaker) {
   438	    const setUniTakerTx = await factory.setTaker(2, addresses.uniswapTaker);
   439	    console.log('✅ UniswapV3 configuration tx:', setUniTakerTx.hash);
   440	    await setUniTakerTx.wait();
   441	    console.log('🎉 Factory configured with UniswapV3 taker');
   442	  }
   443	
   444	  // Register Curve taker (LiquiditySource.CURVE = 4)
   445	  if (addresses.curveTaker) {
   446	    const setCurveTakerTx = await factory.setTaker(
   447	      LiquiditySource.CURVE,
   448	      addresses.curveTaker
   449	    );
   450	    console.log('✅ Curve configuration tx:', setCurveTakerTx.hash);
   451	    await setCurveTakerTx.wait();
   452	    console.log('🎉 Factory configured with Curve taker');
   453	  }
   454	
   455	  // LI.FI taker registration is intentionally NOT done here. It is registered
   456	  // by registerLifiTakerInFactory only AFTER configureLifiAllowlists has
   457	  // applied and exactly verified the call-target/approval-spender/selector
   458	  // allowlists, so the factory never maps LiquiditySource.LIFI to a taker whose
   459	  // on-chain allowlists are incomplete or unverified.
   460	  // ADD DELAY AFTER CONFIGURATION
   461	  await new Promise((resolve) => setTimeout(resolve, 1000)); // 1 second delay
   462	}
