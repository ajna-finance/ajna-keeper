    64	    function atomicSwapCallback(uint256 collateral, uint256 quoteAmountDue, bytes calldata data) external override nonReentrant {
    65	        IERC20Pool pool = IERC20Pool(msg.sender);
    66	        if (!_validatePool(pool)) revert InvalidPool();
    67	
