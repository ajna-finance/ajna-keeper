   450	export function resolveExternalTakeDeployment(params: {
   451	  liquiditySource: LiquiditySource | undefined;
   452	  config: ExternalTakeDeploymentRuntimeConfig;
   453	}): ExternalTakeDeploymentResolution {
   454	  const source = params.liquiditySource;
   455	  if (!isExternalTakeLiquiditySource(source)) {
   456	    return {
   457	      deploymentType: 'none',
   458	      requestedLiquiditySource: source,
   459	    };
   460	  }
   461	
   462	  const contractKey = getExternalTakeTakerContractKeyForSource(source);
   463	  const resolvedTakerAddress = getConfiguredExternalTakeTaker({
   464	    source,
   465	    config: params.config,
   466	  });
   467	  if (!params.config.keeperTakerRouter) {
   468	    return {
   469	      deploymentType: 'none',
   470	      requestedLiquiditySource: source,
   471	      unavailableReason: 'keeperTakerRouter is not configured',
   472	    };
   473	  }
   474	  if (!resolvedTakerAddress) {
   475	    return {
   476	      deploymentType: 'none',
   477	      requestedLiquiditySource: source,
   478	      unavailableReason: contractKey
   479	        ? `takerContracts.${contractKey} is not configured`
   480	        : 'registered taker contract is not configured',
   481	    };
   482	  }
   483	  if (isCalldataAggregatorLiquiditySource(source)) {
   484	    const providerId = resolveCalldataAggregatorProviderForSource(source);
   485	    if (!providerId) {
   486	      return {
   487	        deploymentType: 'none',
   488	        requestedLiquiditySource: source,
   489	        unavailableReason: 'calldata aggregator provider is not configured',
   490	      };
   491	    }
   492	    return {
   493	      deploymentType: 'calldata_aggregator',
   494	      providerId,
   495	      requestedLiquiditySource: source,
   496	      resolvedTakerAddress,
   497	    };
   498	  }
   499	  return {
   500	    deploymentType: 'direct_dex',
   501	    requestedLiquiditySource: source,
   502	    resolvedTakerAddress,
   503	  };
   504	}
