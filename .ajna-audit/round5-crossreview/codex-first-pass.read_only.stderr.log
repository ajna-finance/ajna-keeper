   286	function buildAggregatorProviderIdentities(
   287	  identities: readonly CalldataAggregatorSourceIdentity[]
   288	): Record<CalldataAggregatorProviderId, CalldataAggregatorSourceIdentity> {
   289	  const identitiesByProvider: Partial<
   290	    Record<CalldataAggregatorProviderId, CalldataAggregatorSourceIdentity>
   291	  > = {};
   292	  const seenProviderIds = new Set<CalldataAggregatorProviderId>();
   293	
   294	  for (const identity of identities) {
   295	    if (seenProviderIds.has(identity.providerId)) {
   296	      throw new Error(
   297	        `Duplicate calldata aggregator provider id: ${identity.providerId}`
   298	      );
   299	    }
   300	    seenProviderIds.add(identity.providerId);
   301	    identitiesByProvider[identity.providerId] = identity;
   302	  }
   303	
   304	  return identitiesByProvider as Record<
   305	    CalldataAggregatorProviderId,
   306	    CalldataAggregatorSourceIdentity
   307	  >;
