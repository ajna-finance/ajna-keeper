   376	function normalizeAutoDiscoverActionPolicy<T extends AutoDiscoverActionPolicy>(
   377	  value?: boolean | T
   378	): T | undefined {
   379	  if (!value) {
   380	    return undefined;
   381	  }
   382	  if (value === true) {
   383	    return { enabled: true } as T;
   384	  }
   385	  if (value.enabled === false) {
   386	    return undefined;
   387	  }
   388	  return {
   389	    ...value,
   390	    enabled: value.enabled ?? true,
   391	  };
   392	}
   393	
   394	export function getAutoDiscoverTakePolicy(
   395	  autoDiscover?: AutoDiscoverConfig
   396	): AutoDiscoverTakePolicy | undefined {
