   237	export function evaluateExternalTakeBoundaries(
   238	  files: readonly BoundaryFile[]
   239	): BoundaryViolation[] {
   240	  const violations: BoundaryViolation[] = [];
   241	  for (const file of files) {
   242	    if (isIgnoredPath(file.file)) {
   243	      continue;
   244	    }
   245	    const normalizedFile = file.file.split(path.sep).join('/');
   246	    if (normalizedFile.startsWith('src/take/factory/')) {
   247	      violations.push({
   248	        file: file.file,
   249	        line: 1,
   250	        rule: 'retired-factory-module-path',
   251	        detail:
   252	          'src/take/factory production module path is retired; use src/take/direct-dex',
   253	        text: normalizedFile,
   254	      });
   255	    }
   256	    const lines = file.content.split('\n');
   257	    lines.forEach((line, index) => {
   258	      for (const rule of BOUNDARY_RULES) {
   259	        if (!rule.re.test(line)) {
   260	          continue;
   261	        }
   262	        const lineNumber = index + 1;
   263	        if (rule.allow?.({ file: normalizedFile, line, lineNumber }) === true) {
   264	          continue;
   265	        }
   266	        violations.push({
   267	          file: file.file,
   268	          line: lineNumber,
   269	          rule: rule.id,
   270	          detail: rule.detail,
   271	          text: line.trim(),
   272	        });
   273	      }
   274	    });
   275	  }
   276	  return violations;
   277	}
   278	
   279	export function parseBaseRef(argv: readonly string[]): string | undefined {
   280	  const flagIndex = argv.indexOf('--base');
   281	  if (flagIndex === -1 || flagIndex + 1 >= argv.length) {
   282	    return undefined;
   283	  }
   284	  const value = argv[flagIndex + 1];
   285	  return value && !value.startsWith('--') ? value : undefined;
   286	}
   287	
   288	function shouldScanFile(file: string): boolean {
   289	  return SCAN_EXTENSIONS.has(path.extname(file));
   290	}
   291	
   292	function collectFiles(root: string, out: string[]): void {
   293	  if (!fs.existsSync(root)) {
   294	    return;
   295	  }
   296	  const stat = fs.statSync(root);
   297	  if (stat.isFile()) {
   298	    if (shouldScanFile(root)) {
   299	      out.push(root);
   300	    }
   301	    return;
   302	  }
   303	  for (const entry of fs.readdirSync(root, { withFileTypes: true })) {
   304	    const fullPath = path.join(root, entry.name);
   305	    if (entry.isDirectory()) {
   306	      collectFiles(fullPath, out);
   307	    } else if (entry.isFile() && shouldScanFile(fullPath)) {
   308	      out.push(fullPath);
   309	    }
   310	  }
   311	}
   312	
   313	export function collectBoundaryFiles(repoRoot = process.cwd()): BoundaryFile[] {
   314	  const files: string[] = [];
   315	  for (const root of SCAN_ROOTS) {
   316	    collectFiles(path.join(repoRoot, root), files);
   317	  }
   318	  for (const file of SCAN_FILES) {
   319	    const fullPath = path.join(repoRoot, file);
   320	    if (fs.existsSync(fullPath) && shouldScanFile(fullPath)) {
   321	      files.push(fullPath);
   322	    }
   323	  }
   324	  return files.map((file) => ({
   325	    file: path.relative(repoRoot, file).split(path.sep).join('/'),
   326	    content: fs.readFileSync(file, 'utf8'),
   327	  }));
   328	}
   329	
   330	function main(): void {
   331	  const baseRef = parseBaseRef(process.argv.slice(2));
   332	  if (!baseRef) {
   333	    console.error(
   334	      'check-external-take-boundaries: an explicit --base <ref> is required'
   335	    );
   336	    process.exit(2);
   337	  }
   338	  const violations = evaluateExternalTakeBoundaries(collectBoundaryFiles());
   339	  if (violations.length > 0) {
   340	    for (const violation of violations) {
   341	      console.error(
   342	        `FAIL [${violation.rule}] ${violation.file}:${violation.line}: ` +
   343	          `${violation.detail} (${violation.text})`
   344	      );
   345	    }
   346	    console.error(
   347	      `${violations.length} external-take boundary violation(s) against base ${baseRef}`
   348	    );
   349	    process.exit(1);
   350	  }
   351	  console.log(`external-take boundary check passed against ${baseRef}`);
   352	}
   353	
   354	if (require.main === module) {
   355	  main();
   356	}

