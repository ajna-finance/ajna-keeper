   161	    const expectedProviderId = resolveCalldataAggregatorProviderForSource(
   162	      params.liquiditySource
   163	    );
   164	    if (
   165	      expectedProviderId === undefined ||
   166	      calldataQuote.providerId !== expectedProviderId
   167	    ) {
   168	      return rejected(
   169	        `${params.label} quote providerId ${calldataQuote.providerId} does not match source ${params.liquiditySource}`
