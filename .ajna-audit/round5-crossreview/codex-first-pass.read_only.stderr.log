    20	export function deriveApprovedMinOutRaw(params: {
    21	  routeMinOutRaw?: BigNumber;
    22	  profitMinOutRaw?: BigNumber;
    23	  fallbackMinOutRaw?: BigNumber;
    24	}): BigNumber | undefined {
