    34	        IERC20Pool pool,
    35	        address borrowerAddress,
    36	        uint256 auctionPrice,
    37	        uint256 maxAmount,
    38	        LiquiditySource source,
    39	        address swapRouter,
    40	        bytes calldata swapDetails
    41	    ) external onlyOwnerOrRouter {
    42	        if (source != LiquiditySource.UniswapV3) revert UnsupportedSource();
    43	        if (!_validatePool(pool)) revert InvalidPool();
    44	
    45	        UniswapV3SwapDetails memory details = abi.decode(swapDetails, (UniswapV3SwapDetails));
    46	        require(swapRouter != address(0) && details.swapRouter == swapRouter, "Router mismatch");
    47	        require(details.targetToken == pool.quoteTokenAddress(), "Invalid target");
    48	        require(details.deadline > block.timestamp, "Expired deadline");
    49	        require(details.amountOutMinimum > 0, "Invalid minimum amount");
    50	
    51	        // Ajna's take() may clamp the collateral actually purchased below maxAmount on
    52	        // debt-constrained auctions, so the callback pro-rates amountOutMinimum (quoted for
    53	        // the full planned size) against this on-chain derived planned input.
    54	        bytes memory data = abi.encode(details, TakerTakeScaling.plannedTakeAmount(pool, maxAmount));
    55	
    56	        _approveQuoteForTake(pool, maxAmount, auctionPrice);
    57	
    58	        pool.take(borrowerAddress, maxAmount, address(this), data);
    59	
    60	        _settleAfterTake(pool);
