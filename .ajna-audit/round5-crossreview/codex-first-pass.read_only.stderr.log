     1	import { BigNumber, constants } from 'ethers';
     2	import { ExternalTakePathKind } from '../config/schema';
     3	import { isAggregatorExternalTakePath } from '../config/external-take-descriptors';
     4	import { AuctionTakeFacts } from './types';
     5	
     6	/**
     7	 * Conservative lower bound of the collateral Ajna's take() will purchase when
     8	 * borrower debt is the binding constraint.
     9	 *
    10	 * Ajna computes the debt-constrained purchase as
    11	 * roundUpToScale(ceilWdiv(debt, (1 - |bpf|) * auctionPrice)), so dividing the
    12	 * debt by the undiscounted auction price and rounding down can only
    13	 * underestimate it. Auction price decays monotonically and debt only accrues
    14	 * interest between planning and inclusion, so a take submitted with
    15	 * maxAmount <= this bound fills exactly maxAmount. Aggregator paths rely on
    16	 * that exact-fill property: LI.FI calldata cannot be re-sized on-chain and the
    17	 * 1inch executor calldata is only reliable at its quoted input size.
    18	 */
    19	export function getDebtConstrainedTakeCollateralWad(
    20	  params: AuctionTakeFacts
    21	): BigNumber {
    22	  if (
    23	    params.debtToCover === undefined ||
    24	    !params.debtToCover.gt(0) ||
    25	    !params.auctionPrice.gt(0)
    26	  ) {
    27	    return params.collateral;
    28	  }
    29	  const debtConstrainedWad = params.debtToCover
    30	    .mul(constants.WeiPerEther)
    31	    .div(params.auctionPrice);
    32	  return debtConstrainedWad.lt(params.collateral)
    33	    ? debtConstrainedWad
    34	    : params.collateral;
    35	}
    36	
    37	/**
    38	 * The collateral size a route's quote is expected to be denominated in.
    39	 * Aggregator-category paths (1inch and calldata aggregators such as LI.FI)
    40	 * quote and execute the debt-clamped size; direct DEX paths quote the full
    41	 * collateral and let the taker contract pro-rate the min-out to whatever
    42	 * Ajna actually fills. The non-resizable classification is keyed on the
    43	 * registry's aggregator category, not the calldata_aggregator family alone,
    44	 * so 1inch keeps exact-fill sizing and Packet 3B providers inherit it
    45	 * without touching this module.
    46	 */
    47	export function getExpectedQuotedCollateralWad(
    48	  params: AuctionTakeFacts & {
    49	    externalTakePath: ExternalTakePathKind | undefined;
    50	  }
    51	): BigNumber {
    52	  if (
    53	    params.externalTakePath === undefined ||
    54	    !isAggregatorExternalTakePath(params.externalTakePath)
    55	  ) {
    56	    return params.collateral;
    57	  }
    58	  return getDebtConstrainedTakeCollateralWad(params);
