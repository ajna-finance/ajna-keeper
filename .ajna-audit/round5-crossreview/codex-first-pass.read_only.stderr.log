   221	        for (uint256 i = 0; i < _callTargetList.length; i++) {
   222	            address target = _callTargetList[i];
   223	            if (_callTargets[target]) {
   224	                targets[index] = target;
   225	                index++;
   226	            }
   227	        }
   228	    }
   229	
   230	    function getAllowedApprovalSpenders() external view returns (address[] memory spenders) {
   231	        uint256 count = 0;
   232	        for (uint256 i = 0; i < _approvalSpenderList.length; i++) {
   233	            if (_approvalSpenders[_approvalSpenderList[i]]) {
   234	                count++;
   235	            }
   236	        }
   237	        spenders = new address[](count);
   238	        uint256 index = 0;
   239	        for (uint256 i = 0; i < _approvalSpenderList.length; i++) {
   240	            address spender = _approvalSpenderList[i];
   241	            if (_approvalSpenders[spender]) {
   242	                spenders[index] = spender;
   243	                index++;
   244	            }
   245	        }
   246	    }
   247	
   248	    function getAllowedCallSelectors(address target) external view returns (bytes4[] memory selectors) {
   249	        uint256 count = 0;
   250	        for (uint256 i = 0; i < _callSelectorList[target].length; i++) {
   251	            if (_callSelectors[target][_callSelectorList[target][i]]) {
   252	                count++;
   253	            }
   254	        }
   255	        selectors = new bytes4[](count);
   256	        uint256 index = 0;
   257	        for (uint256 i = 0; i < _callSelectorList[target].length; i++) {
   258	            bytes4 selector = _callSelectorList[target][i];
   259	            if (_callSelectors[target][selector]) {
   260	                selectors[index] = selector;
   261	                index++;
   262	            }
   263	        }
   264	    }
   265	
   266	    function _executeAggregatorCall(
   267	        IERC20Pool pool,
   268	        uint256 quoteAmountDue,
   269	        address swapRouter,
   270	        AggregatorSwapDetails memory details
   271	    ) private {
   272	        IERC20 srcToken = IERC20(details.srcToken);
   273	        IERC20 dstToken = IERC20(details.dstToken);
   274	        uint256 sourceBalanceBefore = srcToken.balanceOf(address(this));
   275	        if (sourceBalanceBefore != details.amountInTokenUnits) {
   276	            revert UnexpectedSourceBalance();
   277	        }
   278	
   279	        uint256 quoteBalanceBefore = dstToken.balanceOf(address(this));
   280	        _safeApproveWithReset(srcToken, details.approvalSpender, details.amountInTokenUnits);
   281	        _callAggregatorTarget(swapRouter, details.callData);
   282	        _safeApproveWithReset(srcToken, details.approvalSpender, 0);
   283	
   284	        uint256 quoteReceived = dstToken.balanceOf(address(this)) - quoteBalanceBefore;
   285	        uint256 quoteAmountDueCeiling = TakerTakeScaling.quoteAmountDueCeiling(pool, quoteAmountDue);
   286	        uint256 requiredQuoteReceived = details.amountOutMinimum > quoteAmountDueCeiling
   287	            ? details.amountOutMinimum
   288	            : quoteAmountDueCeiling;
   289	        if (quoteReceived < requiredQuoteReceived) {
   290	            revert InsufficientQuoteReceived();
   291	        }
   292	
   293	        emit AggregatorSwapExecuted(
   294	            _source,
   295	            swapRouter,
   296	            pool.collateralAddress(),
   297	            pool.quoteTokenAddress(),
   298	            details.amountInTokenUnits,
   299	            quoteReceived
   300	        );
   301	    }
   302	
   303	    function _callAggregatorTarget(address swapRouter, bytes memory callData) private {
   304	        (bool success, bytes memory returnData) = swapRouter.call(callData);
   305	        if (success) {
   306	            return;
   307	        }
   308	        if (returnData.length > 0) {
   309	            assembly {
   310	                revert(add(returnData, 32), mload(returnData))
   311	            }
   312	        }
   313	        revert SwapFailed();
   314	    }
   315	
   316	    function _validateSwapDetails(
   317	        IERC20Pool pool,
   318	        address swapRouter,
   319	        AggregatorSwapDetails memory details
   320	    ) private view {
   321	        if (
   322	            swapRouter == address(0) ||
   323	            details.approvalSpender == address(0) ||
   324	            details.srcToken != pool.collateralAddress() ||
   325	            details.dstToken != pool.quoteTokenAddress() ||
   326	            details.dstReceiver != address(this) ||
   327	            details.amountInTokenUnits == 0 ||
   328	            details.amountOutMinimum == 0 ||
   329	            details.callData.length < 4
   330	        ) {
   331	            revert InvalidSwapDetails();
   332	        }
   333	        if (!_callTargets[swapRouter]) revert CallTargetNotAllowed();
   334	        // A low-level call to an address with no code returns success with empty
   335	        // return data, so a misconfigured (or self-destructed) allowlisted target
   336	        // would no-op rather than swap. Defense-in-depth alongside the off-chain
   337	        // preflight code-existence check: fail closed before the call is made.
   338	        if (swapRouter.code.length == 0) revert CallTargetHasNoCode();
   339	        if (!_approvalSpenders[details.approvalSpender]) revert ApprovalSpenderNotAllowed();
   340	        if (!_callSelectors[swapRouter][_selector(details.callData)]) revert SelectorNotAllowed();
   341	    }
   342	
   343	    function _selector(bytes memory callData) private pure returns (bytes4 selector) {
   344	        assembly {
   345	            selector := mload(add(callData, 32))
   346	        }
   347	    }
   348	}

