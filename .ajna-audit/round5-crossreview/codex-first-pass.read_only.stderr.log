    95	        return source == LiquiditySource.UniswapV3;
    96	    }
    97	
    98	    /// @dev Execute an exact-input Uniswap V3 swap using collateral held by this taker.
    99	    /// @param quoteAmountDueCeiling Ajna repayment backstop, already adjusted for the
   100	    ///        pool's ceil-rounded quote pull (TakerTakeScaling.quoteAmountDueCeiling).
   101	    function _swapWithUniswapV3(
   102	        address tokenIn,
   103	        address tokenOut,
   104	        uint256 amountIn,
   105	        uint256 quoteAmountDueCeiling,
   106	        uint256 plannedAmountIn,
   107	        UniswapV3SwapDetails memory details
   108	    ) private {
   109	        if (amountIn == 0 || block.timestamp >= details.deadline) {
   110	            revert SwapFailed();
   111	        }
   112	
   113	        uint256 amountOutMinimum =
   114	            TakerTakeScaling.scaleAmountOutMinimum(details.amountOutMinimum, amountIn, plannedAmountIn);
   115	
   116	        IERC20 tokenInContract = IERC20(tokenIn);
   117	        uint256 quoteBalanceBefore = IERC20(tokenOut).balanceOf(address(this));
   118	
   119	        _safeApproveWithReset(tokenInContract, details.swapRouter, amountIn);
   120	        ISwapRouter02(details.swapRouter).exactInputSingle(
   121	            ISwapRouter02.ExactInputSingleParams({
   122	                tokenIn: tokenIn,
   123	                tokenOut: tokenOut,
   124	                fee: details.feeTier,
   125	                recipient: address(this),
   126	                amountIn: amountIn,
   127	                amountOutMinimum: amountOutMinimum,
   128	                sqrtPriceLimitX96: 0
   129	            })
   130	        );
   131	        _safeApproveWithReset(tokenInContract, details.swapRouter, 0);
   132	
   133	        uint256 quoteReceived = IERC20(tokenOut).balanceOf(address(this)) - quoteBalanceBefore;
   134	        if (quoteReceived < amountOutMinimum || quoteReceived < quoteAmountDueCeiling) {
   135	            revert InsufficientQuoteReceived();
   136	        }
   137	        emit SwapExecuted(tokenIn, tokenOut, amountIn, quoteReceived);
   138	    }
   139	}

