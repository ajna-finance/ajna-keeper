    19	/**
    20	 * The single calldata-aggregator execution approval helper (Packet 2B).
    21	 * Validates the canonical path, the expected provider id, the provider's
    22	 * liquidity source, takeability, the raw quote amount, the min-out floor,
    23	 * and the normalized calldataQuote before execution. Provider wrappers must
    24	 * not clone this into provider-specific approval helpers.
    25	 */
    26	export function approveCalldataAggregatorQuoteForExecution(params: {
    27	  quoteEvaluation: ExternalTakeQuoteEvaluation;
    28	  providerId: CalldataAggregatorProviderId;
    29	  poolName: string;
    30	  borrower: string;
    31	}): CalldataAggregatorQuoteApprovalResult {
    32	  const { quoteEvaluation, providerId, poolName, borrower } = params;
    33	  const identity = getAggregatorProviderIdentity(providerId);
    34	  const label = identity.label;
    35	  const context = `${poolName}/${borrower}`;
    36	
    37	  if (!quoteEvaluation.isTakeable) {
    38	    return {
    39	      approved: false,
    40	      reason: `${label} quote no longer satisfies execution policy for ${context}: ${quoteEvaluation.reason ?? 'not takeable'}`,
    41	    };
    42	  }
    43	  if (!quoteEvaluation.quoteAmountRaw) {
    44	    return {
    45	      approved: false,
    46	      reason: `${label} quote is missing raw quote amount for ${context}`,
    47	    };
    48	  }
    49	  if (quoteEvaluation.externalTakePath !== 'calldata_aggregator') {
    50	    return {
    51	      approved: false,
    52	      reason: `${label} execution received a non-calldata-aggregator approved path for ${context}`,
    53	    };
    54	  }
    55	  if (quoteEvaluation.selectedLiquiditySource !== identity.source) {
    56	    return {
    57	      approved: false,
    58	      reason: `${label} execution received an unexpected approved source for ${context}`,
    59	    };
    60	  }
    61	  if (!quoteEvaluation.calldataQuote) {
    62	    return {
    63	      approved: false,
    64	      reason: `${label} execution is missing validated route details for ${context}`,
    65	    };
    66	  }
    67	  if (quoteEvaluation.calldataQuote.providerId !== providerId) {
    68	    return {
    69	      approved: false,
    70	      reason: `${label} execution received a quote from provider ${quoteEvaluation.calldataQuote.providerId} for ${context}`,
    71	    };
    72	  }
    73	  const approvedMinOutRaw = deriveRouteExecutionFloorRaw(quoteEvaluation);
    74	  if (!approvedMinOutRaw) {
    75	    return {
    76	      approved: false,
    77	      reason: `${label} execution is missing approved min-out floor for ${context}`,
    78	    };
    79	  }
    80	  return {
    81	    approved: true,
    82	    quoteEvaluation: {
    83	      ...quoteEvaluation,
    84	      isTakeable: true,
    85	      externalTakePath: 'calldata_aggregator',
    86	      providerId,
    87	      quoteAmountRaw: quoteEvaluation.quoteAmountRaw,
    88	      selectedLiquiditySource: identity.source,
    89	      routeExecutionFloorRaw:
    90	        quoteEvaluation.routeExecutionFloorRaw ?? approvedMinOutRaw,
    91	      approvedMinOutRaw,
    92	      calldataQuote: quoteEvaluation.calldataQuote,
    93	    },
    94	  };
    95	}

