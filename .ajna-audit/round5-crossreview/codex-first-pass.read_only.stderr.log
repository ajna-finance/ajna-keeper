   569	export async function takeLiquidationCalldataAggregatorProvider<
   570	  TConfig extends CalldataAggregatorExecutionConfigBase,
   571	>(
   572	  params: CalldataAggregatorProviderExecutionParams<TConfig> & {
   573	    providerId: CalldataAggregatorProviderId;
   574	    liquiditySource: LiquiditySource;
   575	    label: string;
   576	    prepareExecution: (
   577	      params: CalldataAggregatorProviderExecutionParams<TConfig>
   578	    ) => Promise<PreparedCalldataAggregatorExecution>;
   579	    recordPreparedRejection: (
   580	      config: TConfig,
   581	      rejection: CalldataAggregatorPreBroadcastRejection
   582	    ) => void;
   583	    onQuoteConsumed: (config: TConfig) => void;
   584	    onExecutionFailure: (
   585	      config: TConfig,
   586	      result: { preBroadcast: boolean; error?: string }
   587	    ) => void;
   588	  }
   589	): Promise<boolean> {
   590	  const { pool, liquidation, config } = params;
   591	  const { borrower } = liquidation;
   592	  if (
   593	    !isCalldataAggregatorExecutionPathSelected({
   594	      poolConfig: params.poolConfig,
   595	      liquidation,
   596	      providerId: params.providerId,
   597	    })
   598	  ) {
   599	    logger.error(
   600	      `${params.label} liquidity source not selected. Skipping liquidation of poolAddress: ${pool.poolAddress}, borrower: ${borrower}.`
   601	    );
   602	    return false;
   603	  }
   604	
   605	  let attemptedSubmission = false;
   606	  try {
   607	    const prepared = await params.prepareExecution(params);
   608	    if (prepared.kind === 'rejected') {
   609	      params.recordPreparedRejection(config, prepared);
   610	      return false;
   611	    }
   612	    if (prepared.kind === 'dry_run') {
   613	      logger.info(
   614	        `DryRun - would ${params.label} Take - poolAddress: ${pool.poolAddress}, borrower: ${borrower}, approvedMinOutRaw=${prepared.approvedQuoteEvaluation.approvedMinOutRaw.toString()}`
   615	      );
   616	      return true;
   617	    }
   618	
   619	    await submitPreparedCalldataAggregatorExecution({
   620	      pool,
   621	      liquidation,
   622	      prepared,
   623	      liquiditySource: params.liquiditySource,
   624	      providerId: params.providerId,
   625	      label: params.label,
   626	      onQuoteConsumed: () => params.onQuoteConsumed(config),
   627	      onSubmissionAccepted: () => {
   628	        attemptedSubmission = true;
   629	      },
   630	    });
   631	    return true;
   632	  } catch (error) {
   633	    params.onExecutionFailure(config, {
   634	      preBroadcast:
   635	        !attemptedSubmission && !isNonceConsumedTransactionError(error),
   636	      error: getErrorMessage(error),
   637	    });
   638	    logger.error(
   639	      `Failed ${params.label} Take. pool: ${pool.name}, borrower: ${borrower}`,
   640	      error
   641	    );
   642	    return false;
   643	  }
   644	}

