    60	        address borrowerAddress_,
    61	        uint256 maxAmount_,
    62	        address callee_,
    63	        bytes calldata data_
    64	    ) external returns (uint256 collateralTaken_) {
    65	        collateralTaken_ = collateralTakenOverride != 0 ? collateralTakenOverride : maxAmount_;
    66	        lastBorrower = borrowerAddress_;
    67	        lastCallee = callee_;
    68	        lastCollateralTaken = collateralTaken_;
