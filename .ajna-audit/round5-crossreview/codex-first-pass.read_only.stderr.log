   464	async function verifyDeployment(
   465	  deployer: ethers.Wallet,
   466	  addresses: DeploymentAddresses
   467	): Promise<void> {
   468	  console.log('\n🔍 Step 4: Verifying deployment...');
   469	
   470	  if (!addresses.factory) {
   471	    throw new Error('Factory address is missing from deployment');
   472	  }
   473	
   474	  const factoryArtifact = require(
   475	    path.join(
   476	      __dirname,
   477	      '..',
   478	      'artifacts',
   479	      'contracts',
   480	      'factories',
   481	      'TakerRouter.sol',
   482	      'TakerRouter.json'
   483	    )
   484	  );
   485	  const factory = new ethers.Contract(
   486	    addresses.factory,
   487	    factoryArtifact.abi,
   488	    deployer
   489	  );
   490	
   491	  // Verify factory configuration
   492	  const hasUniswapTaker = await factory.hasConfiguredTaker(2);
   493	  const registeredTaker = await factory.takerContracts(2);
   494	  const factoryOwner = await factory.owner();
   495	
   496	  console.log('📋 Verification Results:');
   497	  console.log(`- Factory Owner: ${factoryOwner}`);
   498	  console.log(`- Expected Owner: ${deployer.address}`);
   499	  console.log(`- UniswapV3 Configured: ${hasUniswapTaker}`);
   500	  console.log(`- Registered Taker: ${registeredTaker}`);
   501	  console.log(`- Expected Taker: ${addresses.uniswapTaker}`);
   502	
   503	  // Verify taker authorization
   504	  if (addresses.uniswapTaker) {
   505	    const takerArtifact = require(
   506	      path.join(
   507	        __dirname,
   508	        '..',
   509	        'artifacts',
   510	        'contracts',
   511	        'takers',
   512	        'UniswapV3KeeperTaker.sol',
   513	        'UniswapV3KeeperTaker.json'
   514	      )
   515	    );
   516	    const taker = new ethers.Contract(
   517	      addresses.uniswapTaker,
   518	      takerArtifact.abi,
   519	      deployer
   520	    );
   521	
   522	    const takerOwner = await taker.owner();
   523	    const authorizedRouter = await taker.authorizedRouter();
   524	
   525	    console.log(`- Taker Owner: ${takerOwner}`);
   526	    console.log(`- Authorized Router: ${authorizedRouter}`);
   527	    console.log(`- Expected Router: ${addresses.factory}`);
   528	
   529	    // Validation checks
   530	    if (!hasUniswapTaker || registeredTaker !== addresses.uniswapTaker) {
   531	      throw new Error('❌ Factory configuration verification failed');
   532	    }
   533	
   534	    if (authorizedRouter !== addresses.factory) {
   535	      throw new Error('❌ Taker authorization verification failed');
   536	    }
   537	
   538	    if (takerOwner !== deployer.address || factoryOwner !== deployer.address) {
   539	      throw new Error('❌ Owner verification failed');
   540	    }
   541	  }
   542	
   543	  if (addresses.lifiTaker) {
   544	    const hasLifiTaker = await factory.hasConfiguredTaker(LiquiditySource.LIFI);
   545	    const registeredLifiTaker = await factory.takerContracts(
   546	      LiquiditySource.LIFI
   547	    );
   548	    console.log(`- LI.FI Configured: ${hasLifiTaker}`);
   549	    console.log(`- Registered LI.FI Taker: ${registeredLifiTaker}`);
   550	    console.log(`- Expected LI.FI Taker: ${addresses.lifiTaker}`);
   551	
   552	    const takerArtifact = require(
   553	      path.join(
   554	        __dirname,
   555	        '..',
   556	        'artifacts',
   557	        'contracts',
   558	        'takers',
   559	        'LifiKeeperTaker.sol',
   560	        'LifiKeeperTaker.json'
   561	      )
   562	    );
   563	    const taker = new ethers.Contract(
   564	      addresses.lifiTaker,
   565	      takerArtifact.abi,
   566	      deployer
   567	    );
   568	
   569	    const takerOwner = await taker.owner();
   570	    const authorizedRouter = await taker.authorizedRouter();
   571	
   572	    console.log(`- LI.FI Taker Owner: ${takerOwner}`);
   573	    console.log(`- LI.FI Authorized Router: ${authorizedRouter}`);
   574	    console.log(`- Expected Router: ${addresses.factory}`);
   575	
   576	    if (
   577	      !hasLifiTaker ||
   578	      registeredLifiTaker.toLowerCase() !== addresses.lifiTaker.toLowerCase()
   579	    ) {
   580	      throw new Error('❌ LI.FI factory configuration verification failed');
   581	    }
   582	
   583	    if (authorizedRouter.toLowerCase() !== addresses.factory.toLowerCase()) {
   584	      throw new Error('❌ LI.FI taker authorization verification failed');
   585	    }
   586	
   587	    if (
   588	      takerOwner.toLowerCase() !== deployer.address.toLowerCase() ||
   589	      factoryOwner.toLowerCase() !== deployer.address.toLowerCase()
   590	    ) {
   591	      throw new Error('❌ LI.FI owner verification failed');
   592	    }
   593	  }
   594	
   595	  console.log('✅ All verification checks passed');
   596	}
