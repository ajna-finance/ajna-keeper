   200	        }
   201	
   202	        // Execute the swap; Address.functionCall bubbles reverts and fails loudly on a
   203	        // non-contract pool address. The balance-delta check below is the output guard.
   204	        Address.functionCall(details.poolAddress, swapCalldata, "Curve swap failed");
   205	
   206	        _safeApproveWithReset(tokenInContract, details.poolAddress, 0);
   207	
   208	        uint256 quoteReceived = IERC20(details.tokenOut).balanceOf(address(this)) - quoteBalanceBefore;
   209	        if (quoteReceived < amountOutMin || quoteReceived < quoteAmountDueCeiling) {
   210	            revert InsufficientQuoteReceived();
   211	        }
   212	
   213	        emit SwapExecuted(details.tokenIn, details.tokenOut, amountIn, quoteReceived);
   214	    }
   215	}

codex
The three calldata-aggregator wrappers are thin over the shared base, while Uniswap and Curve keep direct-DEX callback logic. I’m checking the interface choices and the test coverage next, especially around `SafeERC20`, fee-on-transfer behavior, stale balances, selector/target allowlists, and quote-ceiling regressions.
