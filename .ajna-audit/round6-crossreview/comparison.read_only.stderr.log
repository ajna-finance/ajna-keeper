   500	        () => params.factory.estimateGas.takeWithAtomicSwap(...txArgs),
   501	        `${params.label} Take ${params.poolName}/${params.borrower}`,
   502	        13000
   503	      );
   504	      params.assertFreshQuoteStillCurrent();
   505	      const txRequest =
   506	        await params.factory.populateTransaction.takeWithAtomicSwap(...txArgs, {
   507	          gasLimit,
   508	          nonce: nonce.toString(),
   509	        });
   510	      params.assertFreshQuoteStillCurrent();
   511	      params.onQuoteConsumed?.();
