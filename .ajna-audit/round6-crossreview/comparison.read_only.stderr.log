   231	    );
   232	  }
   233	}
   234	
   235	function normalizeSelectorList(
   236	  selectors: readonly string[] | undefined
   237	): string[] {
   238	  return Array.from(
   239	    new Set((selectors ?? []).map((selector) => selector.toLowerCase()))
   240	  ).sort();
   241	}
   242	
   243	function getSelectorsForTarget(
   244	  selectorAllowlist: Record<string, readonly string[]>,
   245	  target: string
   246	): readonly string[] {
   247	  return (
   248	    selectorAllowlist[target] ??
   249	    selectorAllowlist[target.toLowerCase()] ??
   250	    selectorAllowlist[ethers.utils.getAddress(target)] ??
   251	    []
   252	  );
   253	}
   254	
   255	function normalizeSelectorsForTarget(params: {
   256	  target: string;
   257	  selectors: readonly string[];
   258	  label: string;
   259	  requireNonEmpty?: boolean;
   260	}): string[] {
   261	  if (!params.requireNonEmpty && params.selectors.length === 0) {
   262	    return [];
   263	  }
   264	  const normalized = normalizeTakerSelectorAllowlistRecord(
   265	    { [params.target]: params.selectors },
   266	    { label: params.label, requireNonEmpty: params.requireNonEmpty }
   267	  );
   268	  return normalized[ethers.utils.getAddress(params.target).toLowerCase()] ?? [];
   269	}
   270	
   271	function getSelectorTargets(params: {
   272	  expected?: Pick<NormalizedTakerAllowlistPolicy, 'callTargets' | 'selectorAllowlist'>;
   273	  actual?: {
   274	    callTargets: readonly string[];
   275	    selectorAllowlist: Record<string, readonly string[]>;
   276	  };
   277	  extra?: readonly string[];
   278	}): string[] {
   279	  const selectorTargets = new Map<string, string>();
   280	  for (const target of [
   281	    ...(params.expected?.callTargets ?? []),
   282	    ...Object.keys(params.expected?.selectorAllowlist ?? {}),
   283	    ...(params.actual?.callTargets ?? []),
   284	    ...Object.keys(params.actual?.selectorAllowlist ?? {}),
   285	    ...(params.extra ?? []),
   286	  ]) {
   287	    selectorTargets.set(target.toLowerCase(), target);
   288	  }
   289	  return Array.from(selectorTargets.values());
   290	}
   291	
   292	function formatSet(values: readonly string[]): string {
   293	  return values.join(', ');
   294	}
   295	
   296	function getSetMismatch(params: {
   297	  label: string;
   298	  expected: readonly string[];
   299	  actual: readonly string[];
   300	  mode: TakerAllowlistCompareMode;
   301	}): string | undefined {
   302	  const expected = sortLower(params.expected);
   303	  const actual = sortLower(params.actual);
   304	  if (params.mode === 'contains') {
   305	    const actualSet = toLowerSet(actual);
   306	    const missing = expected.filter((value) => !actualSet.has(value));
   307	    return missing.length > 0
   308	      ? `${params.label} missing expected entries: [${formatSet(missing)}]`
   309	      : undefined;
   310	  }

