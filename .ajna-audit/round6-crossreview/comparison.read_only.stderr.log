   486	  await NonceTracker.queueTransaction(
   487	    params.takeWriteTransport.signer,
   488	    async (nonce: number) => {
   489	      params.assertFreshQuoteStillCurrent();
   490	      const txArgs = [
   491	        params.poolAddress,
