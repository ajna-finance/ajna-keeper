   264	    function _executeAggregatorCall(
   265	        IERC20Pool pool,
   266	        uint256 collateral,
   267	        uint256 quoteAmountDue,
   268	        address swapRouter,
   269	        AggregatorSwapDetails memory details
   270	    ) private {
   271	        IERC20 srcToken = IERC20(details.srcToken);
   272	        IERC20 dstToken = IERC20(details.dstToken);
   273	        // Trust the validated pool's reported callback collateral rather than
   274	        // this taker's own token balance: an attacker can force a non-zero
   275	        // balance by donating 1 wei of srcToken, so a balanceOf-based exact-fill
   276	        // check would let them grief every take. The approval below is sized to
   277	        // amountInTokenUnits, so any donated dust is never spent and is swept by
   278	        // _settleAfterTake. (Matches CurveKeeperTaker / UniswapV3KeeperTaker.)
   279	        if (collateral != details.amountInTokenUnits) {
   280	            revert UnexpectedSourceBalance();
   281	        }
   282	
   283	        uint256 quoteBalanceBefore = dstToken.balanceOf(address(this));
   284	        _safeApproveWithReset(srcToken, details.approvalSpender, details.amountInTokenUnits);
   285	        _callAggregatorTarget(swapRouter, details.callData);
   286	        _safeApproveWithReset(srcToken, details.approvalSpender, 0);
   287	
   288	        uint256 quoteReceived = dstToken.balanceOf(address(this)) - quoteBalanceBefore;
   289	        uint256 quoteAmountDueCeiling = TakerTakeScaling.quoteAmountDueCeiling(pool, quoteAmountDue);
   290	        uint256 requiredQuoteReceived = details.amountOutMinimum > quoteAmountDueCeiling
   291	            ? details.amountOutMinimum
   292	            : quoteAmountDueCeiling;
   293	        if (quoteReceived < requiredQuoteReceived) {
   294	            revert InsufficientQuoteReceived();
   295	        }
   296	
   297	        emit AggregatorSwapExecuted(
   298	            _source,
   299	            swapRouter,
   300	            pool.collateralAddress(),
   301	            pool.quoteTokenAddress(),
   302	            details.amountInTokenUnits,
   303	            quoteReceived
   304	        );
   305	    }
