    11	const SELECTOR = '0xabcdef12';
    12	
    13	function keeperConfig(dex: KeeperConfig['dex']): KeeperConfig {
    14	  return {
    15	    network: {
    16	      rpcUrl: 'http://localhost:8545',
    17	      subgraph: { url: 'http://localhost:8000' },
    18	    },
    19	    signer: { keystore: '/tmp/keeper.json' },
    20	    runtime: { logLevel: 'info', delayBetweenRuns: 60 },
    21	    ajna: {
    22	      erc20PoolFactory: '0x3333333333333333333333333333333333333333',
    23	      erc721PoolFactory: '0x4444444444444444444444444444444444444444',
    24	      poolUtils: '0x5555555555555555555555555555555555555555',
    25	      positionManager: '0x6666666666666666666666666666666666666666',
    26	      ajnaToken: '0x7777777777777777777777777777777777777777',
    27	      grantFund: '',
    28	      burnWrapper: '',
    29	      lenderHelper: '',
    30	    },
    31	    manual: { pools: [] },
    32	    dex,
    33	  };
    34	}
    35	
    36	function sushiConfig(
    37	  overrides: Partial<SushiAggregatorDexConfig> = {}
    38	): KeeperConfig {
    39	  return keeperConfig({
    40	    sushiAggregator: {
    41	      mode: 'production',
    42	      callTargetAllowlist: { [BASE_CHAIN_ID]: [CALL_TARGET] },
    43	      approvalSpenderAllowlist: { [BASE_CHAIN_ID]: [APPROVAL_SPENDER] },
    44	      selectorAllowlist: { [BASE_CHAIN_ID]: { [CALL_TARGET]: [SELECTOR] } },
    45	      ...overrides,
    46	    },
    47	  });
    48	}
    49	
    50	describe('Sushi aggregator deployment script support', () => {
    51	  it('enables Sushi taker deployment only when dex.sushiAggregator is configured', () => {
    52	    expect(hasSushiAggregatorConfig(sushiConfig())).to.equal(true);
    53	    expect(hasSushiAggregatorConfig(keeperConfig({}))).to.equal(false);
    54	  });
    55	
    56	  it('resolves reviewed allowlists for the detected chain', () => {
    57	    const allowlists = getSushiAggregatorProductionAllowlists(
    58	      sushiConfig(),
    59	      BASE_CHAIN_ID
    60	    );
    61	
    62	    expect(allowlists.callTargets).to.deep.equal([CALL_TARGET]);
    63	    expect(allowlists.approvalSpenders).to.deep.equal([APPROVAL_SPENDER]);
    64	    expect(allowlists.selectorAllowlist).to.deep.equal({
    65	      [CALL_TARGET.toLowerCase()]: [SELECTOR],
    66	    });
    67	  });
    68	
    69	  it('fails closed when config does not cover the detected chain', () => {
    70	    expect(() =>
    71	      getSushiAggregatorProductionAllowlists(sushiConfig(), 1)
    72	    ).to.throw('dex.sushiAggregator.callTargetAllowlist[1]');
    73	  });
    74	
    75	  it('throws when no dex.sushiAggregator config is present', () => {
    76	    expect(() =>
    77	      getSushiAggregatorProductionAllowlists(keeperConfig({}), BASE_CHAIN_ID)
    78	    ).to.throw('dex.sushiAggregator config is required');
    79	  });
    80	});

