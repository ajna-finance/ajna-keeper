    97	export function recordCalldataAggregatorPreBroadcastRejection<TConfig>(params: {
    98	  config: TConfig;
    99	  rejection: CalldataAggregatorPreBroadcastRejection;
   100	  onQuoteResult: (
   101	    config: TConfig,
   102	    result: CalldataAggregatorQuoteResultNotification
   103	  ) => void;
   104	  onExecutionFailure: (
   105	    config: TConfig,
   106	    result: {
   107	      preBroadcast: boolean;
   108	      error?: string;
   109	    }
   110	  ) => void;
   111	}): void {
   112	  if (params.rejection.logError) {
   113	    logger.error(params.rejection.reason);
   114	  }
   115	  if (params.rejection.quoteResult) {
   116	    params.onQuoteResult(params.config, params.rejection.quoteResult);
   117	  }
   118	  params.onExecutionFailure(params.config, {
   119	    preBroadcast: true,
   120	    error: params.rejection.reason,
   121	  });
   122	}
