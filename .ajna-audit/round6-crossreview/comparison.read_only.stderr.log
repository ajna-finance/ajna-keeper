   216	function normalizeAddressList(
   217	  addresses: readonly string[] | undefined,
   218	  label: string,
   219	  requireNonEmpty = false
   220	): string[] {
   221	  try {
   222	    return sortLower(
   223	      normalizeTakerAddressAllowlist(addresses, {
   224	        label,
   225	        requireNonEmpty,
   226	      })
   227	    );
   228	  } catch (error) {
   229	    throw new Error(
