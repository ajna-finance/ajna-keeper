   133	    result: CalldataAggregatorQuoteResultNotification
   134	  ) => void;
   135	  onExecutionFailure: (
   136	    config: TConfig,
   137	    result: { preBroadcast: boolean; error?: string }
   138	  ) => void;
   139	}): (
   140	  config: TConfig,
   141	  rejection: CalldataAggregatorPreBroadcastRejection
   142	) => void {
   143	  return (config, rejection) =>
   144	    recordCalldataAggregatorPreBroadcastRejection({
   145	      config,
   146	      rejection,
   147	      onQuoteResult: selectors.onQuoteResult,
   148	      onExecutionFailure: selectors.onExecutionFailure,
   149	    });
   150	}
