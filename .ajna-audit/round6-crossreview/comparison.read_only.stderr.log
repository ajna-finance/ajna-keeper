   326	            swapRouter == address(0) ||
   327	            details.approvalSpender == address(0) ||
   328	            details.srcToken != pool.collateralAddress() ||
   329	            details.dstToken != pool.quoteTokenAddress() ||
   330	            details.dstReceiver != address(this) ||
   331	            details.amountInTokenUnits == 0 ||
   332	            details.amountOutMinimum == 0 ||
   333	            details.callData.length < 4
