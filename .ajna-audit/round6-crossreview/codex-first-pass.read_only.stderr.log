    63	export function getQuoteAmountDueRawForScale(params: {
    64	  quoteTokenScale: BigNumber;
    65	  auctionPriceWad: BigNumber;
    66	  collateralWad: BigNumber;
    67	}): BigNumber {
    68	  // Round repayment up so execution min-out covers the exact Ajna quote obligation.
    69	  return ceilDiv(
    70	    ceilWmul(params.collateralWad, params.auctionPriceWad),
    71	    params.quoteTokenScale
    72	  );
    73	}
