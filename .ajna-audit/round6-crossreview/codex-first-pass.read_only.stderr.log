   268	export function normalizeLifiProductionPolicy(params: {
   269	  config: LifiChainPolicyConfig;
   270	  fieldName: string;
   271	  chainId?: number;
   272	}): NormalizedLifiProductionPolicy {
   273	  if (params.config.mode !== 'production') {
   274	    throw new Error(`${params.fieldName}.mode must be production`);
   275	  }
   276	  const productionConfig = params.config as LifiProductionChainPolicyConfig;
   277	  const exchangePolicy = normalizeProductionLifiExchangePolicy({
   278	    config: productionConfig,
   279	    fieldName: params.fieldName,
   280	  });
   281	  return {
   282	    exchangePolicy,
   283	    filters: exchangePolicy.filters,
   284	    chains: normalizeProductionChains({
   285	      config: productionConfig,
   286	      fieldName: params.fieldName,
   287	      chainId: params.chainId,
   288	    }),
   289	  };
   290	}
   291	
   292	export function normalizeLifiProductionChainPolicy(params: {
   293	  config: LifiChainPolicyConfig;
   294	  fieldName: string;
   295	  chainId: number;
   296	}): NormalizedLifiChainPolicy {
   297	  const policy = normalizeLifiProductionPolicy({
   298	    config: params.config,
   299	    fieldName: params.fieldName,
   300	    chainId: params.chainId,
   301	  });
   302	  const chain = policy.chains.find((entry) => entry.chainId === params.chainId);
   303	  if (!chain) {
   304	    throw new Error(
   305	      `${params.fieldName}.callTargetAllowlist.${params.chainId} is required`
   306	    );
   307	  }
   308	  return chain;
   309	}
