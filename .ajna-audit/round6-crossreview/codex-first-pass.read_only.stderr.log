   404	  }
   405	  const floorError = getAggregatorFreshQuoteFloorError({
   406	    freshQuote,
   407	    approvedMinOutRaw: approvedQuoteEvaluation.approvedMinOutRaw,
   408	    label: params.label,
   409	  });
   410	  if (floorError) {
