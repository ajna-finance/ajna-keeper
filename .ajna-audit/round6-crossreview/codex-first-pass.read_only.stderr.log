    44	      throw new Error(
    45	        `${params.label} contains invalid address ${String(address)}`
    46	      );
    47	    }
    48	    const normalizedAddress = ethers.utils.getAddress(address).toLowerCase();
    49	    if (normalizedAddress === ZERO_ADDRESS) {
