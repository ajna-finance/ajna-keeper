   213	function isRetryableRpcReadError(error: unknown): boolean {
   214	  const maybeError = error as { code?: unknown; reason?: unknown };
   215	  const code =
   216	    typeof maybeError.code === 'string' ? maybeError.code.toLowerCase() : '';
   217	  const reason =
   218	    typeof maybeError.reason === 'string'
   219	      ? maybeError.reason.toLowerCase()
   220	      : '';
   221	  const message = getErrorMessage(error).toLowerCase();
   222	  return [
   223	    'timeout',
   224	    'timed out',
   225	    'econnreset',
   226	    'econnrefused',
   227	    'etimedout',
   228	    'network',
   229	    '429',
   230	    '502',
   231	    '503',
   232	    '504',
   233	    'server error',
   234	    'bad gateway',
   235	  ].some(
   236	    (needle) =>
   237	      code.includes(needle) ||
   238	      reason.includes(needle) ||
   239	      message.includes(needle)
   240	  );
   241	}
   242	
   243	async function retryRpcRead<T>(operation: () => Promise<T>): Promise<{
   244	  value?: T;
   245	  error?: unknown;
   246	}> {
   247	  let lastError: unknown;
   248	  for (
   249	    let attempt = 0;
   250	    attempt <= FACTORY_REGISTRY_READ_RETRY_DELAYS_MS.length;
   251	    attempt += 1
   252	  ) {
   253	    try {
   254	      return { value: await operation() };
   255	    } catch (error) {
   256	      lastError = error;
   257	      if (
   258	        !isRetryableRpcReadError(error) ||
   259	        attempt === FACTORY_REGISTRY_READ_RETRY_DELAYS_MS.length
   260	      ) {
   261	        break;
   262	      }
   263	      await sleepMs(FACTORY_REGISTRY_READ_RETRY_DELAYS_MS[attempt]);
   264	    }
   265	  }
   266	  return { error: lastError };
   267	}
