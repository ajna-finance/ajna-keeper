   219	export interface AutoDiscoverTakePolicy extends AutoDiscoverActionPolicy {
   220	  /**
   221	   * Quote-token profit floor in human token units. When both this and
   222	   * minProfitNative are set, the effective floor is the stricter of this
   223	   * quote-denominated floor and the freshly converted native floor.
   224	   *
   225	   * Prefer minProfitNative for cross-token keeper operations where quote assets
   226	   * differ across discovered pools.
   227	   */
   228	  minExpectedProfitQuote?: number;
   229	  /**
   230	   * Native-token profit floor in wei. Quoted fresh into each candidate's quote
   231	   * token for external takes; arb-takes are skipped when this is set because
   232	   * they do not produce quote-normalized profit.
   233	   */
   234	  minProfitNative?: string;
   235	  takeQuoteBudgetPerRun?: number;
   236	  /**
   237	   * Milliseconds to keep already-seen liquidation candidates eligible for
   238	   * probing even if the next subgraph refresh omits them. Set to 0 to disable.
   239	   */
   240	  hotAuctionCandidateTtlMs?: number;
   241	  /**
   242	   * Maximum hot-auction candidates retained in memory across take cycles.
   243	   */
   244	  maxHotAuctionCandidates?: number;
   245	  /**
   246	   * External take execution paths eligible for discovered liquidation takes.
   247	   * When omitted, autodiscover preserves the single-path behavior from
   248	   * discovery.defaults.take.liquiditySource unless
   249	   * allowedCalldataAggregatorProviders explicitly enables multiple providers
   250	   * inside the derived calldata_aggregator family.
   251	   */
   252	  allowedExternalTakePaths?: ExternalTakePathKind[];
   253	  /**
   254	   * Calldata-aggregator providers allowed to quote and compete inside the
   255	   * `calldata_aggregator` family. Omitted follows source-derived defaults
   256	   * such as ONEINCH -> oneinch and otherwise falls back to LI.FI when the
   257	   * family is enabled. An explicit multi-provider list engages hybrid
   258	   * provider selection even when allowedExternalTakePaths is omitted. A
   259	   * non-empty list requires the family to be enabled; empty lists, duplicates,
   260	   * and unknown or packet-inactive ids are invalid.
   261	   */
   262	  allowedCalldataAggregatorProviders?: CalldataAggregatorProviderId[];
   263	  /**
   264	   * Direct DEX path to use when discovery.defaults.take.liquiditySource is an
   265	   * aggregator source but allowedExternalTakePaths also enables direct_dex.
   266	   */
   267	  defaultDirectDexLiquiditySource?: LiquiditySource;
   268	  /**
   269	   * Freshness windows for gas prices used in discovered external-take
   270	   * profitability checks. L2 defaults are intentionally longer than L1.
   271	   */
   272	  l1GasPriceFreshnessTtlMs?: number;
   273	  l2GasPriceFreshnessTtlMs?: number;
   274	  /**
   275	   * Basis-point multiplier applied to estimated L2 gas costs to cover L1 data
   276	   * fees and sequencer-specific cost drift. 13000 means 1.3x.
   277	   */
   278	  l2GasCostBufferBasisPoints?: number;
   279	  /**
   280	   * Optional maximum allowed absolute gas-price drift between quote evaluation
   281	   * and final pre-submission approval. Only upward drift rejects; lower gas is
   282	   * favorable. 2000 means 20%. When omitted, freshness TTLs still apply but
   283	   * drift does not reject otherwise-fresh quotes.
   284	   */
   285	  gasPriceDriftToleranceBasisPoints?: number;
   286	  /**
   287	   * Maximum time to wait for a 1inch quote while probing hybrid external-take
   288	   * paths and for the matching 1inch swap-data request before submission.
   289	   * Defaults to 2000ms. Must be between 1ms and 10000ms.
   290	   */
   291	  oneInchQuoteTimeoutMs?: number;
   292	  /**
   293	   * Cooldown after repeated retryable 1inch quote failures. Defaults to 30000ms.
   294	   */
   295	  oneInchQuoteFailureCooldownMs?: number;
   296	  /**
   297	   * Retryable 1inch quote failures before cooldown opens. Defaults to 2.
   298	   */
   299	  oneInchQuoteFailureThreshold?: number;
   300	  /**
   301	   * Maximum time to wait for each external-take path probe in hybrid mode.
   302	   * Defaults to oneInchQuoteTimeoutMs plus a 1000ms RPC preflight budget,
   303	   * capped at 5000ms. Must be between 1ms and 10000ms when configured.
   304	   */
   305	  externalTakeProbeTimeoutMs?: number;
   306	  /**
   307	   * Hybrid route selection mode. maximize_profit probes all enabled paths and
   308	   * picks the best net-profit route. direct_dex_first probes direct DEX routes
   309	   * before aggregator providers and stops at the first non-subsidized approved
   310	   * path; subsidized approvals keep probing remaining paths.
   311	   */
   312	  externalTakeRouteSelectionMode?: ExternalTakeRouteSelectionMode;
   313	  /**
   314	   * Disabled-by-default escape hatch for hybrid maximize_profit discovery when
   315	   * collateral->quote direct DEX execution is viable but native gas cannot be
   316	   * quoted into the pool quote token. When enabled, fallback approval uses only
   317	   * native gas caps and rejects quote-denominated policy fields at runtime.
   318	   */
   319	  hybridGasQuoteFailureFallbackMode?: HybridGasQuoteFailureFallbackMode;
   320	  /**
   321	   * Controls whether discovered external takes may fall back to public RPC
   322	   * submission, or must use private RPC / relay write transport.
   323	   */
   324	  externalTakeTransportPolicy?: ExternalTakeTransportPolicy;
   325	  /**
   326	   * Optional startup preflight that checks enabled route contracts have code
   327	   * and router taker registry entries match configured taker addresses.
   328	   */
   329	  validateRouteDeployments?: boolean;
   330	  /**
   331	   * Maximum direct DEX quote probes per liquidation candidate. Only applies
   332	   * when discovery.defaults.take.liquiditySource is a direct DEX route source.
   333	   */
   334	  takeRouteQuoteBudgetPerCandidate?: number;
   335	  /**
   336	   * Opt-in bounded parallel liquidation candidate evaluation. Defaults to 1,
   337	   * which preserves sequential evaluation and execution behavior.
   338	   */
   339	  maxConcurrentCandidateEvaluations?: number;
   340	  /**
   341	   * Maximum successful borrower/candidate decisions for one discovered pool in
   342	   * a single take cycle. A candidate that executes both an external take and a
   343	   * follow-up arbTake counts once. Defaults to 1 so same-pool cascades are
   344	   * retried on the next cycle unless explicitly opted into deeper per-cycle
   345	   * execution. Values above 1 force sequential same-pool candidate evaluation.
   346	   */
   347	  maxExecutionsPerPoolPerRun?: number;
   348	  /**
   349	   * Global cap on concurrent route/API/RPC probes used only when candidate
   350	   * evaluation concurrency is greater than 1.
   351	   */
   352	  maxInFlightRouteProbes?: number;
   353	  /**
   354	   * Direct DEX sources eligible for dynamic route selection. Aggregator sources
   355	   * are selected through allowedCalldataAggregatorProviders.
   356	   */
   357	  allowedLiquiditySources?: LiquiditySource[];
   358	  dexGasOverrides?: LiquiditySourceMap<string>;
   359	}
