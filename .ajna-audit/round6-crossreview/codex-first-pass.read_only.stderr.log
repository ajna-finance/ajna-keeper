    14	contract UniswapV3KeeperTaker is RouterAuthorizedTakerBase {
    15	    /// @notice Direct Uniswap V3 swap configuration encoded by the keeper.
    16	    struct UniswapV3SwapDetails {
    17	        address swapRouter;
    18	        address targetToken;
