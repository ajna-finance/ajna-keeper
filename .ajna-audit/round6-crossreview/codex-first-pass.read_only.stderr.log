    95	    );
    96	  }
    97	  if (
    98	    config.defaultSlippage !== undefined &&
    99	    (config.defaultSlippage <= 0 ||
   100	      config.defaultSlippage > SUSHI_AGGREGATOR_POLICY_BOUNDS.maxSlippage)
   101	  ) {
   102	    throw new Error(
