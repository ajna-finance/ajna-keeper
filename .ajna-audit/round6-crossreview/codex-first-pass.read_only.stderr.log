    22	async function resolveChainIdUncached(
    23	  signerOrProvider: SignerOrProvider
    24	): Promise<number | undefined> {
    25	  const candidate = signerOrProvider as SignerOrProvider & {
    26	    getChainId?: () => Promise<number>;
    27	    provider?: providers.Provider;
    28	    network?: { chainId?: number };
    29	    _network?: { chainId?: number };
    30	    getNetwork?: () => Promise<{ chainId: number }>;
    31	  };
    32	
    33	  try {
    34	    if (typeof candidate.getChainId === 'function') {
    35	      return await candidate.getChainId();
    36	    }
    37	    const provider = (candidate.provider ?? candidate) as {
    38	      network?: { chainId?: number };
    39	      _network?: { chainId?: number };
    40	      getNetwork?: () => Promise<{ chainId: number }>;
    41	    };
    42	    const cachedNetwork = provider.network ?? provider._network;
    43	    if (typeof cachedNetwork?.chainId === 'number') {
    44	      return cachedNetwork.chainId;
    45	    }
    46	    if (typeof provider.getNetwork === 'function') {
    47	      return (await provider.getNetwork()).chainId;
    48	    }
