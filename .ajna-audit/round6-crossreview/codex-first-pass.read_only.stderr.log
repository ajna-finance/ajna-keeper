    53	export function getMarketPriceFactorUnits(marketPriceFactor: number): number {
    54	  const scaled = Math.floor(marketPriceFactor * MARKET_FACTOR_SCALE);
    55	  if (scaled <= 0) {
    56	    throw new Error(
    57	      `External take: invalid marketPriceFactor ${marketPriceFactor}`
    58	    );
