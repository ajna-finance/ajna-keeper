   316	function formatList(values: readonly string[]): string {
   317	  if (values.length <= 1) {
   318	    return values[0] ?? '';
   319	  }
   320	  if (values.length === 2) {
   321	    return `${values[0]} or ${values[1]}`;
   322	  }
   323	  return `${values.slice(0, -1).join(', ')}, and ${values[values.length - 1]}`;
   324	}
