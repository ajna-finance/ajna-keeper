   256	            bytes4 selector = _callSelectorList[target][i];
   257	            if (_callSelectors[target][selector]) {
   258	                selectors[index] = selector;
   259	                index++;
   260	            }
   261	        }
   262	    }
   263	
   264	    function _executeAggregatorCall(
   265	        IERC20Pool pool,
   266	        uint256 collateral,
   267	        uint256 quoteAmountDue,
   268	        address swapRouter,
   269	        AggregatorSwapDetails memory details
   270	    ) private {
   271	        IERC20 srcToken = IERC20(details.srcToken);
   272	        IERC20 dstToken = IERC20(details.dstToken);
   273	        // Trust the validated pool's reported callback collateral rather than
   274	        // this taker's own token balance: an attacker can force a non-zero
   275	        // balance by donating 1 wei of srcToken, so a balanceOf-based exact-fill
   276	        // check would let them grief every take. The approval below is sized to
   277	        // amountInTokenUnits, so any donated dust is never spent and is swept by
   278	        // _settleAfterTake. (Matches CurveKeeperTaker / UniswapV3KeeperTaker.)
   279	        if (collateral != details.amountInTokenUnits) {
   280	            revert UnexpectedSourceBalance();
   281	        }
   282	
   283	        uint256 quoteBalanceBefore = dstToken.balanceOf(address(this));
   284	        _safeApproveWithReset(srcToken, details.approvalSpender, details.amountInTokenUnits);
   285	        _callAggregatorTarget(swapRouter, details.callData);
   286	        _safeApproveWithReset(srcToken, details.approvalSpender, 0);
   287	
   288	        uint256 quoteReceived = dstToken.balanceOf(address(this)) - quoteBalanceBefore;
   289	        uint256 quoteAmountDueCeiling = TakerTakeScaling.quoteAmountDueCeiling(pool, quoteAmountDue);
   290	        uint256 requiredQuoteReceived = details.amountOutMinimum > quoteAmountDueCeiling
   291	            ? details.amountOutMinimum
   292	            : quoteAmountDueCeiling;
   293	        if (quoteReceived < requiredQuoteReceived) {
   294	            revert InsufficientQuoteReceived();
   295	        }
   296	
   297	        emit AggregatorSwapExecuted(
   298	            _source,
   299	            swapRouter,
   300	            pool.collateralAddress(),
   301	            pool.quoteTokenAddress(),
   302	            details.amountInTokenUnits,
   303	            quoteReceived
   304	        );
   305	    }
   306	
   307	    function _callAggregatorTarget(address swapRouter, bytes memory callData) private {
   308	        (bool success, bytes memory returnData) = swapRouter.call(callData);
   309	        if (success) {
   310	            return;
   311	        }
   312	        if (returnData.length > 0) {
   313	            assembly {
   314	                revert(add(returnData, 32), mload(returnData))
   315	            }
   316	        }
   317	        revert SwapFailed();
   318	    }
   319	
   320	    function _validateSwapDetails(
   321	        IERC20Pool pool,
   322	        address swapRouter,
   323	        AggregatorSwapDetails memory details
   324	    ) private view {
   325	        if (
   326	            swapRouter == address(0) ||
   327	            details.approvalSpender == address(0) ||
   328	            details.srcToken != pool.collateralAddress() ||
   329	            details.dstToken != pool.quoteTokenAddress() ||
   330	            details.dstReceiver != address(this) ||
   331	            details.amountInTokenUnits == 0 ||
   332	            details.amountOutMinimum == 0 ||
   333	            details.callData.length < 4
   334	        ) {
   335	            revert InvalidSwapDetails();
   336	        }
   337	        if (!_callTargets[swapRouter]) revert CallTargetNotAllowed();
   338	        // A low-level call to an address with no code returns success with empty
   339	        // return data, so a misconfigured (or self-destructed) allowlisted target
   340	        // would no-op rather than swap. Defense-in-depth alongside the off-chain
   341	        // preflight code-existence check: fail closed before the call is made.
   342	        if (swapRouter.code.length == 0) revert CallTargetHasNoCode();
   343	        if (!_approvalSpenders[details.approvalSpender]) revert ApprovalSpenderNotAllowed();
   344	        if (!_callSelectors[swapRouter][_selector(details.callData)]) revert SelectorNotAllowed();
   345	    }
   346	
   347	    function _selector(bytes memory callData) private pure returns (bytes4 selector) {
   348	        assembly {
   349	            selector := mload(add(callData, 32))
   350	        }
   351	    }
   352	}

