   312	  config: LifiChainPolicyConfig;
   313	  chainId: number;
   314	  fieldName: string;
   315	  context: string;
   316	}): NormalizedLifiChainPolicy {
   317	  const concretePolicyError = getConcreteProductionLifiPolicyError({
   318	    config: params.config,
   319	    context: params.context,
   320	  });
   321	  if (concretePolicyError !== undefined) {
   322	    throw new Error(concretePolicyError);
