   710	async function main() {
   711	  const args = process.argv.slice(2);
   712	
   713	  if (args.length !== 1) {
   714	    console.error(
   715	      'Usage: npx ts-node scripts/deploy-factory-system.ts <config-file-path>'
   716	    );
   717	    console.error(
   718	      'Example: npx ts-node scripts/deploy-factory-system.ts hemi-conf-settlement.ts'
   719	    );
   720	    console.error('\n Prerequisites:');
   721	    console.error('1. Compile contracts: yarn compile');
   722	    console.error('2. Have your keystore.json file ready');
   723	    console.error('3. Ensure sufficient ETH balance (recommended: >0.01 ETH)');
   724	    process.exit(1);
   725	  }
   726	
   727	  const configPath = args[0];
   728	
   729	  try {
   730	    console.log('🚀 Universal Factory System Deployment');
   731	    console.log('=====================================');
   732	
   733	    // Step 1: Load and validate configuration
   734	    console.log(`📖 Loading configuration from: ${configPath}`);
   735	    const config = await readConfigFile(configPath);
   736	    await validateConfig(config);
   737	
   738	    // Step 2: Detect chain information
   739	    const chainInfo = await detectChainInfo(config);
   740	    console.log(
   741	      `🌐 Target Network: ${chainInfo.name} (Chain ID: ${chainInfo.chainId})`
   742	    );
   743	    validateDetectedChainLifiProductionConfig(config, chainInfo);
   744	
   745	    // Step 3: Load wallet from keystore
   746	    console.log('\n🔐 Loading wallet from keystore...');
   747	    const keystoreJson = readFileSync(config.signer.keystore, 'utf8');
   748	    const pswd = await getKeystorePassword();
   749	
   750	    const wallet = await ethers.Wallet.fromEncryptedJson(keystoreJson, pswd);
   751	    console.log('👤 Loaded wallet:', wallet.address);
   752	
   753	    // Step 4: Connect to network
   754	    const provider = new ethers.providers.JsonRpcProvider(
   755	      config.network.rpcUrl
   756	    );
   757	    const deployer = wallet.connect(provider);
   758	
   759	    const balance = await deployer.getBalance();
   760	    console.log(
   761	      '💰 Account balance:',
   762	      ethers.utils.formatEther(balance),
   763	      'ETH'
   764	    );
   765	
   766	    // Balance check for Hemi - much lower gas costs
   767	    const minRequiredBalance = ethers.utils.parseEther('0.0005'); // 0.0005 ETH minimum for Hemi
   768	    if (balance.lt(minRequiredBalance)) {
   769	      console.warn('⚠️  WARNING: Low balance detected!');
   770	      console.warn('💡 You may need more ETH for deployment');
   771	    } else {
   772	      console.log('✅ Balance sufficient for Hemi deployment');
   773	    }
   774	
   775	    // Step 5: Verify network matches
   776	    const networkCheck = await provider.getNetwork();
   777	    if (networkCheck.chainId !== chainInfo.chainId) {
   778	      throw new Error(
   779	        `Network mismatch! Config suggests ${chainInfo.chainId}, connected to ${networkCheck.chainId}`
   780	      );
   781	    }
   782	
   783	    console.log('\n📋 Deployment Configuration:');
   784	    console.log(`- Network: ${chainInfo.name} (${chainInfo.chainId})`);
   785	    console.log(`- Ajna Pool Factory: ${config.ajna.erc20PoolFactory}`);
   786	    console.log(`- Deployer: ${deployer.address}`);
   787	
   788	    // Step 6: Execute deployment (CORRECT ORDER)
   789	    const addresses: DeploymentAddresses = {};
   790	
   791	    // Deploy factory FIRST
   792	    addresses.factory = await deployFactory(
   793	      deployer,
   794	      config.ajna.erc20PoolFactory,
   795	      chainInfo.chainId
   796	    );
   797	
   798	    // ADD DELAY AFTER FACTORY DEPLOYMENT
   799	    await new Promise((resolve) => setTimeout(resolve, 2000)); // 2 second delay
   800	
   801	    // Deploy Uniswap V3 taker if factory SwapRouter02 routing is configured
   802	    if (config.dex?.uniswapV3?.router) {
   803	      addresses.uniswapTaker = await deployUniswapTaker(
   804	        deployer,
   805	        config.ajna.erc20PoolFactory,
   806	        addresses.factory, // Pass factory address for authorization
   807	        chainInfo.chainId
   808	      );
   809	      // ADD DELAY AFTER UNISWAP DEPLOYMENT
   810	      await new Promise((resolve) => setTimeout(resolve, 2000)); // 2 second delay
   811	    }
   812	
   813	
   814	    // Deploy curve taker if configured
   815	    if (config.dex?.curve) {
   816	      addresses.curveTaker = await deployCurveKeeperTaker(
   817	        deployer,
   818	        config.ajna.erc20PoolFactory,
   819	        addresses.factory,
   820	        chainInfo.chainId
   821	      );
   822	      // ADD DELAY AFTER CURVE DEPLOYMENT
   823	      await new Promise((resolve) => setTimeout(resolve, 2000)); // 2 second delay
   824	    }
   825	
   826	    // Deploy LI.FI taker only for production configs. Canary configs are
   827	    // for route-shape discovery and fork validation, not live registration.
   828	    if (hasProductionLifiConfig(config)) {
   829	      addresses.lifiTaker = await deployLifiKeeperTaker(
   830	        deployer,
   831	        config.ajna.erc20PoolFactory,
   832	        addresses.factory,
   833	        chainInfo.chainId,
   834	        getGasConfig
   835	      );
   836	      // ADD DELAY AFTER LI.FI DEPLOYMENT
   837	      await new Promise((resolve) => setTimeout(resolve, 2000)); // 2 second delay
   838	    }
   839	
   840	    // Deploy Sushi aggregator taker when dex.sushiAggregator is configured.
   841	    if (hasSushiAggregatorConfig(config)) {
   842	      addresses.sushiAggregatorTaker = await deploySushiAggregatorKeeperTaker(
   843	        deployer,
   844	        config.ajna.erc20PoolFactory,
   845	        addresses.factory,
   846	        chainInfo.chainId,
   847	        getGasConfig
   848	      );
   849	      await new Promise((resolve) => setTimeout(resolve, 2000)); // 2 second delay
   850	    }
   851	
   852	    // ADD DELAY BEFORE CONFIGURATION
   853	    console.log('\n⏳ Waiting before configuration...');
   854	    await new Promise((resolve) => setTimeout(resolve, 3000)); // 3 second delay
   855	
   856	    // Step 7: Configure factory
   857	    if (!addresses.factory) {
   858	      throw new Error('Missing factory address for configuration');
   859	    }
   860	    await configureFactory(deployer, addresses.factory, addresses);
   861	    if (addresses.lifiTaker) {
   862	      // Configure + exactly verify the LI.FI taker allowlists FIRST, then
   863	      // register the taker in the factory. This keeps factory enablement
   864	      // strictly downstream of verified config/on-chain agreement: a failure
   865	      // while applying or reconciling allowlists aborts before the factory ever
   866	      // maps LiquiditySource.LIFI to a misconfigured taker.
   867	      await configureLifiAllowlists(
   868	        deployer,
   869	        addresses.lifiTaker,
   870	        config,
   871	        chainInfo.chainId
   872	      );
   873	      await registerLifiTakerInFactory(deployer, addresses.factory, addresses);
   874	    }
   875	    if (addresses.sushiAggregatorTaker) {
   876	      // Same ordering invariant as LI.FI: apply + exactly verify allowlists
   877	      // before the router maps SUSHI_AGGREGATOR to the taker.
   878	      await configureSushiAggregatorAllowlists(
   879	        deployer,
   880	        addresses.sushiAggregatorTaker,
   881	        config,
   882	        chainInfo.chainId
   883	      );
   884	      await registerSushiAggregatorTakerInFactory(
   885	        deployer,
   886	        addresses.factory,
   887	        addresses
   888	      );
   889	    }
   890	
   891	    // Step 8: Verify everything works
   892	    await verifyDeployment(deployer, addresses);
   893	
   894	    // Step 9: Generate configuration update instructions
   895	    generateConfigUpdate(addresses, configPath, chainInfo.name);
   896	  } catch (error: any) {
   897	    console.error('\n💥 Deployment failed:', error.message);
   898	
   899	    // Provide helpful troubleshooting tips
   900	    if (error.message?.includes('insufficient funds')) {
   901	      console.log('\n💡 Tip: Add more ETH to your wallet for deployment');
   902	      console.log('💰 Recommended: 0.01+ ETH for large contract deployments');
   903	    } else if (error.message?.includes('nonce')) {
   904	      console.log('\n💡 Tip: Try again - might be a nonce issue');
   905	      console.log('🔄 Or wait a few seconds and retry');
   906	    } else if (error.message?.includes('gas')) {
   907	      console.log('\n💡 Tip: Gas issues detected');
   908	      console.log('⛽ The script now uses manual gas limits');
   909	      console.log('💰 You may need more ETH for the deployment');
   910	      console.log('🔄 Try adding more ETH and retrying');
   911	    } else if (error.message?.includes('Contract artifacts not found')) {
   912	      console.log('\n💡 Tip: Compile contracts first: yarn compile');
   913	    } else if (error.message?.includes('Cannot find module')) {
   914	      console.log('\n💡 Tip: Make sure contracts are compiled: yarn compile');
   915	    } else if (error.message?.includes('incorrect password')) {
   916	      console.log('\n💡 Tip: Check your keystore password and try again');
   917	    }
   918	
   919	    process.exit(1);
   920	  }
   921	}
