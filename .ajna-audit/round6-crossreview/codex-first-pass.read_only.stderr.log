   412	      kind: 'rejected',
   413	      reason: floorError,
   414	      quoteResult: { success: false, retryable: false, error: floorError },
   415	    };
   416	  }
   417	
   418	  const maxQuoteAgeMs = params.getMaxQuoteAgeMs(config);
   419	  const ageError = getAggregatorQuoteAgeError({
