   434	async function configureFactory(
   435	  deployer: ethers.Wallet,
   436	  factoryAddress: string,
   437	  addresses: DeploymentAddresses
   438	): Promise<void> {
   439	  console.log('\n⚙️  Step 3: Configuring factory with takers...');
   440	
   441	  const factoryArtifact = require(
   442	    path.join(
   443	      __dirname,
   444	      '..',
   445	      'artifacts',
   446	      'contracts',
   447	      'factories',
   448	      'TakerRouter.sol',
   449	      'TakerRouter.json'
   450	    )
   451	  );
   452	  const factory = new ethers.Contract(
   453	    factoryAddress,
   454	    factoryArtifact.abi,
   455	    deployer
   456	  );
   457	
   458	  // Register UniswapV3 taker (LiquiditySource.UNISWAPV3 = 2)
   459	  if (addresses.uniswapTaker) {
   460	    const setUniTakerTx = await factory.setTaker(2, addresses.uniswapTaker);
   461	    console.log('✅ UniswapV3 configuration tx:', setUniTakerTx.hash);
   462	    await setUniTakerTx.wait();
   463	    console.log('🎉 Factory configured with UniswapV3 taker');
   464	  }
   465	
   466	  // Register Curve taker (LiquiditySource.CURVE = 4)
   467	  if (addresses.curveTaker) {
   468	    const setCurveTakerTx = await factory.setTaker(
   469	      LiquiditySource.CURVE,
   470	      addresses.curveTaker
   471	    );
   472	    console.log('✅ Curve configuration tx:', setCurveTakerTx.hash);
   473	    await setCurveTakerTx.wait();
   474	    console.log('🎉 Factory configured with Curve taker');
   475	  }
   476	
   477	  // LI.FI taker registration is intentionally NOT done here. It is registered
   478	  // by registerLifiTakerInFactory only AFTER configureLifiAllowlists has
   479	  // applied and exactly verified the call-target/approval-spender/selector
   480	  // allowlists, so the factory never maps LiquiditySource.LIFI to a taker whose
   481	  // on-chain allowlists are incomplete or unverified.
   482	  // ADD DELAY AFTER CONFIGURATION
   483	  await new Promise((resolve) => setTimeout(resolve, 1000)); // 1 second delay
   484	}
