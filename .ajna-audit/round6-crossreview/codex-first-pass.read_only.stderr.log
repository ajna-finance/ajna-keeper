   415	    tokenIn: string,
   416	    tokenOut: string,
   417	    slippage: number
   418	  ): Promise<{ success: boolean; receipt?: any; error?: string }> {
   419	    if (!process.env.ONEINCH_API) {
   420	      logger.error(
   421	        'ONEINCH_API is not configured in the environment variables'
   422	      );
   423	      return { success: false, error: 'ONEINCH_API is not configured' };
