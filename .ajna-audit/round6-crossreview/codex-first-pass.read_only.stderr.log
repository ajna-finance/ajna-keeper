   562	    approvedMinOutRaw: prepared.approvedQuoteEvaluation.approvedMinOutRaw,
   563	    assertFreshQuoteStillCurrent: prepared.assertFreshQuoteStillCurrent,
   564	    onQuoteConsumed: params.onQuoteConsumed,
