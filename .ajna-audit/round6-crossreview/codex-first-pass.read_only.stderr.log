   335	    quoteEvaluation,
   336	    providerId: params.providerId,
   337	    poolName: pool.name,
   338	    borrower: liquidation.borrower,
   339	  });
   340	  if (!approval.approved) {
   341	    return { kind: 'rejected', reason: approval.reason, logError: true };
   342	  }
   343	
   344	  const contextMismatch = getAggregatorQuoteContextMismatch({
   345	    quoteEvaluation: approval.quoteEvaluation,
   346	    liquidation,
   347	    executionCollateralWad,
   348	    label: params.label,
   349	  });
   350	  if (contextMismatch) {
   351	    return { kind: 'rejected', reason: contextMismatch };
   352	  }
   353	
   354	  const approvedQuoteEvaluation = approval.quoteEvaluation;
   355	  if (config.dryRun) {
   356	    return { kind: 'dry_run', approvedQuoteEvaluation };
   357	  }
