   104	    );
   105	  }
   106	  if (
   107	    config.maxPriceImpact !== undefined &&
   108	    (config.maxPriceImpact <= 0 ||
   109	      config.maxPriceImpact > SUSHI_AGGREGATOR_POLICY_BOUNDS.maxPriceImpactCap)
   110	  ) {
   111	    throw new Error(
   112	      `${fieldName}.maxPriceImpact must be a fraction in (0, ${SUSHI_AGGREGATOR_POLICY_BOUNDS.maxPriceImpactCap}]`
   113	    );
   114	  }
   115	  if (chainId !== undefined) {
   116	    normalizeSushiAggregatorChainPolicy({ config, fieldName, chainId });
   117	  } else {
