   381	        };
   382	      }
   383	      const normalizedDstAmount =
   384	        response.data.dstAmount !== undefined
   385	          ? normalizeOneInchUintAmount(response.data.dstAmount, 'dstAmount')
   386	          : {};
   387	      if (response.data.dstAmount !== undefined && !normalizedDstAmount.value) {
   388	        return {
   389	          success: false,
   390	          error: normalizedDstAmount.error,
   391	          retryable: true,
   392	          errorCode: 'invalid_response',
   393	        };
   394	      }
   395	
   396	      return {
   397	        success: true,
   398	        data: response.data.tx,
   399	        dstAmount: normalizedDstAmount.value,
   400	      };
   401	    } catch (error: Error | any) {
   402	      const errorMsg = getOneInchErrorMessage(error);
   403	      return {
   404	        success: false,
   405	        error: errorMsg,
   406	        retryable: isRetryableOneInchError(error),
   407	        errorCode: getOneInchErrorCode(error),
   408	      };
   409	    }
   410	  }
