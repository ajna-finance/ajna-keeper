   371	    chainId,
   372	    cache: config.tokenDecimalsCache,
   373	  });
   374	  const collateralInTokenDecimals = convertWadToTokenDecimals(
   375	    executionCollateralWad,
   376	    collateralDecimals
   377	  );
   378	  if (collateralInTokenDecimals.isZero()) {
   379	    return {
   380	      kind: 'rejected',
   381	      reason: params.collateralRoundsToZeroReason,
   382	    };
   383	  }
   384	
   385	  let freshQuote: ApprovedCalldataAggregatorQuote;
   386	  try {
   387	    freshQuote = await params.requestValidatedQuote({
