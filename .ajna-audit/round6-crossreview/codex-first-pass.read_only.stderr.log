   107	export async function getDecimalsErc20(
   108	  signer: SignerOrProvider,
   109	  tokenAddress: string,
   110	  chainId?: number
   111	) {
   112	  const resolvedChainId = await resolveChainId(signer, chainId);
   113	  const cacheKey = getDecimalsCacheKey({
   114	    chainId: resolvedChainId,
   115	    tokenAddress,
   116	  });
