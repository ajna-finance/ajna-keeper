   322	
   323	export function normalizeTakerAllowlistSnapshot(params: {
   324	  callTargets: readonly string[];
   325	  approvalSpenders: readonly string[];
   326	  selectorAllowlist: Record<string, readonly string[]>;
   327	  selectorTargets?: readonly string[];
   328	  labelPrefix?: string;
   329	}): TakerAllowlistSnapshot {
   330	  const labelPrefix = params.labelPrefix ?? 'LI.FI taker';
   331	  const callTargets = normalizeAddressList(
   332	    params.callTargets,
   333	    `${labelPrefix} call target allowlist`
   334	  );
   335	  const approvalSpenders = normalizeAddressList(
   336	    params.approvalSpenders,
   337	    `${labelPrefix} approval spender allowlist`
   338	  );
   339	  const selectorTargets = getSelectorTargets({
   340	    actual: {
   341	      callTargets,
   342	      selectorAllowlist: params.selectorAllowlist,
   343	    },
   344	    extra: params.selectorTargets,
   345	  });
   346	  const selectorAllowlist: Record<string, string[]> = {};
   347	  for (const target of selectorTargets) {
   348	    selectorAllowlist[target.toLowerCase()] = normalizeSelectorsForTarget({
   349	      target,
   350	      selectors: getSelectorsForTarget(params.selectorAllowlist, target),
   351	      label: `${labelPrefix} selector allowlist for ${target}`,
   352	      requireNonEmpty: false,
   353	    });
   354	  }
   355	  return {
   356	    callTargets,
   357	    approvalSpenders,
   358	    selectorAllowlist,
   359	  };
   360	}
   361	
   362	export async function readTakerAllowlistSnapshot(params: {
   363	  reader: TakerAllowlistReader;
   364	  selectorTargets?: readonly string[];
   365	  labelPrefix?: string;
   366	  read?: TakerAllowlistRead;
   367	}): Promise<TakerAllowlistSnapshot> {
   368	  const labelPrefix = params.labelPrefix ?? 'LI.FI taker';
   369	  const read =
   370	    params.read ??
   371	    (async <T>(readParams: { operation: () => Promise<T> }): Promise<T> =>
   372	      await readParams.operation());
   373	  const [callTargets, approvalSpenders] = await Promise.all([
   374	    read({
   375	      label: `${labelPrefix} call target allowlist`,
   376	      operation: () => params.reader.getAllowedCallTargets(),
   377	    }),
   378	    read({
   379	      label: `${labelPrefix} approval spender allowlist`,
   380	      operation: () => params.reader.getAllowedApprovalSpenders(),
   381	    }),
   382	  ]);
   383	  const selectorTargets = getSelectorTargets({
   384	    actual: { callTargets, selectorAllowlist: {} },
   385	    extra: params.selectorTargets,
   386	  });
   387	  const selectorEntries = await Promise.all(
   388	    selectorTargets.map(
   389	      async (target): Promise<[string, string[]]> => [
   390	        target.toLowerCase(),
   391	        await read({
   392	          label: `${labelPrefix} selector allowlist for ${target}`,
   393	          operation: () => params.reader.getAllowedCallSelectors(target),
   394	        }),
   395	      ]
   396	    )
   397	  );
   398	  const selectorAllowlist: Record<string, string[]> =
   399	    Object.fromEntries(selectorEntries);
   400	  return normalizeTakerAllowlistSnapshot({
   401	    callTargets,
   402	    approvalSpenders,
   403	    selectorAllowlist,
   404	    selectorTargets,
   405	    labelPrefix,
   406	  });
   407	}
   408	
   409	export function createTakerAllowlistReader(
   410	  contract: ethers.Contract
   411	): TakerAllowlistReader {
   412	  return {
   413	    getAllowedCallTargets: async () => await contract.getAllowedCallTargets(),
   414	    getAllowedApprovalSpenders: async () =>
   415	      await contract.getAllowedApprovalSpenders(),
   416	    getAllowedCallSelectors: async (target: string) =>
   417	      await contract.getAllowedCallSelectors(target),
   418	  };
   419	}
   420	
   421	export function compareTakerAllowlistPolicy(params: {
   422	  expected: NormalizedTakerAllowlistPolicy;
   423	  actual: TakerAllowlistSnapshot;
   424	  mode: TakerAllowlistCompareMode;
   425	  labelPrefix?: string;
   426	}): string[] {
   427	  const labelPrefix = params.labelPrefix ?? 'LI.FI taker';
   428	  const errors: string[] = [];
   429	  const callTargetMismatch = getSetMismatch({
   430	    label: `${labelPrefix} call target allowlist`,
   431	    expected: params.expected.callTargets,
   432	    actual: params.actual.callTargets,
   433	    mode: params.mode,
   434	  });
   435	  if (callTargetMismatch) {
   436	    errors.push(callTargetMismatch);
   437	  }
   438	
   439	  const approvalSpenderMismatch = getSetMismatch({
   440	    label: `${labelPrefix} approval spender allowlist`,
   441	    expected: params.expected.approvalSpenders,
   442	    actual: params.actual.approvalSpenders,
   443	    mode: params.mode,
   444	  });
   445	  if (approvalSpenderMismatch) {
   446	    errors.push(approvalSpenderMismatch);
   447	  }
   448	
   449	  for (const target of getSelectorTargets({
   450	    expected: params.expected,
   451	    actual: params.actual,
   452	  })) {
   453	    const configuredSelectors = getSelectorsForTarget(
   454	      params.expected.selectorAllowlist,
   455	      target
   456	    );
   457	    const expectedSelectors = normalizeSelectorList(configuredSelectors);
   458	    const actualSelectors = normalizeSelectorList(
   459	      getSelectorsForTarget(params.actual.selectorAllowlist, target)
   460	    );
   461	    const selectorMismatch = getSetMismatch({
   462	      label: `${labelPrefix} selector allowlist for ${target}`,
   463	      expected: expectedSelectors,
   464	      actual: actualSelectors,
   465	      mode: params.mode,
   466	    });
   467	    if (selectorMismatch) {
   468	      errors.push(selectorMismatch);
   469	    }
   470	  }
   471	
   472	  return errors;
   473	}
   474	
   475	export function assertTakerAllowlistPolicy(params: {
   476	  expected: NormalizedTakerAllowlistPolicy;
   477	  actual: TakerAllowlistSnapshot;
   478	  mode: TakerAllowlistCompareMode;
   479	  labelPrefix?: string;
   480	}): void {
   481	  const errors = compareTakerAllowlistPolicy(params);
   482	  if (errors.length > 0) {
   483	    throw new Error(errors.join('\n'));
   484	  }
   485	}
   486	
   487	export function buildTakerAllowlistReconciliationPlan(params: {
   488	  desired: NormalizedTakerAllowlistPolicy;
   489	  current: TakerAllowlistSnapshot;
   490	}): TakerAllowlistReconciliationPlan {
   491	  const desiredCallTargets = toLowerSet(params.desired.callTargets);
   492	  const desiredApprovalSpenders = toLowerSet(params.desired.approvalSpenders);
   493	  const currentCallTargets = toLowerSet(params.current.callTargets);
   494	  const currentApprovalSpenders = toLowerSet(params.current.approvalSpenders);
   495	
   496	  const selectorTargets = getSelectorTargets({
   497	    expected: params.desired,
   498	    actual: params.current,
   499	  });
   500	
   501	  const selectorsToEnable: TakerSelectorEntry[] = [];
   502	  const selectorsToDisable: TakerSelectorEntry[] = [];
   503	  for (const target of selectorTargets) {
   504	    const desiredSelectors = toLowerSet(
   505	      getSelectorsForTarget(params.desired.selectorAllowlist, target)
   506	    );
   507	    const currentSelectors = toLowerSet(
   508	      getSelectorsForTarget(params.current.selectorAllowlist, target)
   509	    );
   510	    for (const selector of getSelectorsForTarget(
   511	      params.desired.selectorAllowlist,
   512	      target
   513	    )) {
   514	      if (!currentSelectors.has(selector.toLowerCase())) {
   515	        selectorsToEnable.push({ target, selector });
   516	      }
   517	    }
   518	    for (const selector of getSelectorsForTarget(
   519	      params.current.selectorAllowlist,
   520	      target
   521	    )) {
   522	      if (!desiredSelectors.has(selector.toLowerCase())) {
   523	        selectorsToDisable.push({ target, selector });
   524	      }
   525	    }
   526	  }
   527	
   528	  return {
   529	    callTargetsToEnable: params.desired.callTargets.filter(
   530	      (target) => !currentCallTargets.has(target.toLowerCase())
   531	    ),
   532	    callTargetsToDisable: params.current.callTargets.filter(
   533	      (target) => !desiredCallTargets.has(target.toLowerCase())
   534	    ),
   535	    approvalSpendersToEnable: params.desired.approvalSpenders.filter(
   536	      (spender) => !currentApprovalSpenders.has(spender.toLowerCase())
   537	    ),
   538	    approvalSpendersToDisable: params.current.approvalSpenders.filter(
   539	      (spender) => !desiredApprovalSpenders.has(spender.toLowerCase())
   540	    ),
   541	    selectorsToEnable,
   542	    selectorsToDisable,
   543	    selectorTargets,
   544	  };
   545	}

