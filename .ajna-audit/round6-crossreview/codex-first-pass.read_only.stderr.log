   330	
   331	export function normalizeLifiCanaryChainPolicy(params: {
   332	  callTargets: readonly string[];
   333	  approvalSpenders: readonly string[];
   334	  selectorAllowlist: Record<string, readonly string[]>;
   335	  fieldName: string;
   336	}): NormalizedLifiAllowlistPolicy {
   337	  const callTargets = normalizeLifiAddressAllowlist(params.callTargets, {
   338	    label: `${params.fieldName}.callTargetAllowlist`,
   339	    requireNonEmpty: true,
   340	  });
   341	  const approvalSpenders = normalizeLifiAddressAllowlist(
   342	    params.approvalSpenders,
   343	    {
   344	      label: `${params.fieldName}.approvalSpenderAllowlist`,
   345	      requireNonEmpty: true,
   346	    }
   347	  );
   348	  const selectorAllowlist = normalizeLifiSelectorAllowlistRecord(
   349	    params.selectorAllowlist,
   350	    {
   351	      label: `${params.fieldName}.selectorAllowlist`,
   352	      requireNonEmpty: true,
   353	      callTargetAllowlist: callTargets,
   354	      requireCallTargetCoverage: true,
   355	    }
   356	  );
   357	  return {
   358	    callTargets,
   359	    approvalSpenders,
   360	    selectorAllowlist,
   361	  };
   362	}
   363	
   364	export function getConfiguredLifiCompletePolicyChainIds(
   365	  config: LifiChainPolicyConfig | undefined
   366	): number[] {
   367	  if (config?.mode !== 'production') {
   368	    return [];
   369	  }
   370	  const getChainIds = (record: unknown): Set<number> => {
   371	    if (!isRecord(record)) {
   372	      return new Set();
   373	    }
   374	    return new Set(
   375	      Object.keys(record)
   376	        .map(Number)
   377	        .filter((chainId) => Number.isInteger(chainId) && chainId > 0)
   378	    );
   379	  };
   380	  const chainSets = [
   381	    getChainIds(config.callTargetAllowlist),
   382	    getChainIds(config.approvalSpenderAllowlist),
   383	    getChainIds(config.selectorAllowlist),
   384	  ];
   385	  const [first, ...rest] = chainSets;
   386	  return Array.from(first)
   387	    .filter((chainId) => rest.every((chainSet) => chainSet.has(chainId)))
   388	    .sort((a, b) => a - b);
   389	}

