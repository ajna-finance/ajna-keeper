    54	
    55	async function resolveChainId(
    56	  signerOrProvider: SignerOrProvider,
    57	  chainId?: number
    58	): Promise<number | undefined> {
    59	  if (chainId !== undefined) {
    60	    return chainId;
    61	  }
    62	  if (typeof signerOrProvider !== 'object' || signerOrProvider === null) {
    63	    return undefined;
    64	  }
    65	  const chainIdCache = pendingChainIds;
    66	  const cached = chainIdCache.get(signerOrProvider);
    67	  if (cached) {
    68	    return await cached;
    69	  }
    70	  const pending = resolveChainIdUncached(signerOrProvider).then(
    71	    (resolvedChainId) => {
    72	      if (resolvedChainId === undefined) {
    73	        chainIdCache.delete(signerOrProvider);
    74	      }
    75	      return resolvedChainId;
    76	    }
    77	  );
    78	  chainIdCache.set(signerOrProvider, pending);
    79	  return await pending;
    80	}
