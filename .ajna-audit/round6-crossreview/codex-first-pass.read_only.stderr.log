   544	async function validateExternalTakeSourcePreflight(params: {
   545	  config: KeeperConfig;
   546	  provider: providers.Provider;
   547	  chainId: number;
   548	  source: ExternalTakeLiquiditySource;
   549	  descriptor: ExternalTakeSourcePreflightDescriptor;
   550	  errors: string[];
   551	}): Promise<void> {
   552	  const descriptorInput = {
   553	    config: params.config,
   554	    chainId: params.chainId,
   555	    source: params.source,
   556	  };
   557	  const takerAddress = params.descriptor.getTakerAddress(descriptorInput);
   558	  await requireContractCode({
   559	    provider: params.provider,
   560	    label: params.descriptor.takerLabel(params.source),
   561	    address: takerAddress,
   562	    errors: params.errors,
   563	  });
   564	
   565	  if (params.descriptor.usesTakerRouterRegistry) {
   566	    await validateTakerRouterRegistry({
   567	      provider: params.provider,
   568	      factoryAddress: params.config.takers?.router,
   569	      source: params.source,
   570	      expectedTaker: takerAddress,
   571	      errors: params.errors,
   572	    });
   573	  }
   574	
   575	  for (const requirement of params.descriptor.getContractCodeRequirements(
   576	    descriptorInput
   577	  )) {
   578	    await requireContractCode({
   579	      provider: params.provider,
   580	      label: requirement.label,
   581	      address: requirement.address,
   582	      errors: params.errors,
   583	    });
   584	  }
   585	
   586	  await params.descriptor.validateAdditional?.({
   587	    ...descriptorInput,
   588	    provider: params.provider,
   589	    takerAddress,
   590	    errors: params.errors,
   591	  });
   592	}
   593	
   594	/**
   595	 * Performs startup-only checks for the contracts required by the enabled
   596	 * external-take paths. This is intentionally fail-fast: route
   597	 * deployment mismatches should be fixed before the keeper enters a hot cycle.
   598	 */
   599	export async function validateExternalTakeRouteDeployments(params: {
   600	  config: KeeperConfig;
   601	  provider: providers.Provider;
   602	  chainId: number;
   603	  requirements?: readonly ExternalTakeRoutePreflightRequirement[];
   604	}): Promise<void> {
   605	  const requirements =
   606	    params.requirements ??
   607	    resolveExternalTakeRoutePreflightRequirements(params.config);
   608	  if (requirements.length === 0) {
   609	    return;
   610	  }
   611	
   612	  const errors: string[] = [];
   613	  const sourcePreflights = requirements.map((requirement) => ({
   614	    source: requirement.source,
   615	    descriptor: getExternalTakeSourcePreflightDescriptor(requirement.source),
   616	  }));
   617	  if (
   618	    sourcePreflights.some(({ descriptor }) => descriptor.usesTakerRouterRegistry)
   619	  ) {
   620	    await requireContractCode({
   621	      provider: params.provider,
   622	      label: 'takers.router',
   623	      address: params.config.takers?.router,
   624	      errors,
   625	    });
   626	  }
   627	
   628	  for (const { source, descriptor } of sourcePreflights) {
   629	    await validateExternalTakeSourcePreflight({
   630	      config: params.config,
   631	      provider: params.provider,
   632	      chainId: params.chainId,
   633	      source,
   634	      descriptor,
   635	      errors,
   636	    });
   637	  }
   638	
   639	  if (errors.length > 0) {
   640	    throw new Error(
   641	      `Route deployment preflight failed:\n${errors
   642	        .map((error) => `- ${error}`)
   643	        .join('\n')}`
   644	    );
   645	  }
   646	
   647	  logger.info('Route deployment preflight passed');
   648	}
   649	
   650	export async function validateAutoDiscoverRouteDeployments(params: {
   651	  config: KeeperConfig;
   652	  provider: providers.Provider;
   653	  chainId: number;
   654	}): Promise<void> {
   655	  await validateExternalTakeRouteDeployments({
   656	    ...params,
   657	    requirements: resolveAutodiscoverRoutePreflightRequirements(params.config),
   658	  });
   659	}

