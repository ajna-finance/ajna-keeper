   108	export async function buildExternalTakeQuoteEconomics(params: {
   109	  pool: FungiblePool;
   110	  displayAuctionPrice: number;
   111	  auctionPriceWad?: BigNumber;
   112	  collateralWad: BigNumber;
   113	  collateralInTokenDecimals: BigNumber;
   114	  collateralDecimals: number;
   115	  quoteDecimals: number;
   116	  quoteAmountRaw: BigNumber;
   117	  routeMinOutRaw?: BigNumber;
   118	  marketPriceFactor: number;
   119	  allowSubsidy?: boolean;
   120	}): Promise<ExternalTakeQuoteEconomics> {
   121	  const collateralAmount = Number(
   122	    ethers.utils.formatUnits(
   123	      params.collateralInTokenDecimals,
   124	      params.collateralDecimals
   125	    )
   126	  );
   127	  const quoteAmount = Number(
   128	    ethers.utils.formatUnits(params.quoteAmountRaw, params.quoteDecimals)
   129	  );
   130	  const marketPrice = quoteAmount / collateralAmount;
   131	  const effectiveAuctionPriceWad =
   132	    params.auctionPriceWad ?? decimaledToWei(params.displayAuctionPrice);
   133	  const quoteAmountDueRaw = await getQuoteAmountDueRaw(
   134	    params.pool,
   135	    effectiveAuctionPriceWad,
   136	    params.collateralWad
   137	  );
   138	  const marketFactorFloorQuoteRaw = getMarketFactorFloorQuoteRaw({
   139	    quoteAmountDueRaw,
   140	    marketPriceFactor: params.marketPriceFactor,
   141	  });
   142	  const policy = applyExternalTakeRoutePolicy({
   143	    configuredMarketPriceFactor: params.marketPriceFactor,
   144	    allowSubsidy: params.allowSubsidy === true,
   145	    quoteAmountRaw: params.quoteAmountRaw,
   146	    quoteDueRaw: quoteAmountDueRaw,
   147	    marketFactorFloorQuoteRaw,
   148	    routeMinOutRaw: params.routeMinOutRaw,
   149	  });
   150	
   151	  return {
   152	    collateralAmount,
   153	    quoteAmount,
   154	    marketPrice,
   155	    takeablePrice: marketPrice * policy.effectiveMarketPriceFactor,
   156	    effectiveAuctionPriceWad,
   157	    quoteAmountDueRaw,
   158	    marketFactorFloorQuoteRaw,
   159	    policy,
   160	  };
   161	}

