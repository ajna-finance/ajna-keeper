   392	      chainId,
   393	      collateralInTokenDecimals,
   394	    });
   395	  } catch (error) {
   396	    const failure = params.getFailureMetadata(error);
   397	    params.onQuoteResult(config, {
   398	      success: false,
   399	      retryable: failure.retryable,
   400	      errorCode: failure.code,
   401	      error: getErrorMessage(error),
   402	    });
