    32	async function readWithRetries<T>(params: {
    33	  label: string;
    34	  operation: () => Promise<T>;
    35	}): Promise<T> {
    36	  let lastError: unknown;
    37	  for (let attempt = 0; attempt <= PREFLIGHT_READ_RETRY_DELAYS_MS.length; attempt++) {
    38	    try {
    39	      return await params.operation();
    40	    } catch (error) {
    41	      lastError = error;
    42	      const delay = PREFLIGHT_READ_RETRY_DELAYS_MS[attempt];
    43	      if (delay !== undefined) {
