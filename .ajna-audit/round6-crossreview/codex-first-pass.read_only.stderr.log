   432	  return {
   433	    kind: 'ready',
   434	    approvedQuoteEvaluation,
   435	    freshQuote,
   436	    swapDetails: encodeAggregatorSwapDetails({
   437	      quote: freshQuote,
   438	      amountOutMinimum: approvedQuoteEvaluation.approvedMinOutRaw,
