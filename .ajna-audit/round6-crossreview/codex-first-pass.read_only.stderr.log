    49	
    50	function isRecord(value: unknown): value is Record<string, unknown> {
    51	  return typeof value === 'object' && value !== null && !Array.isArray(value);
    52	}
    53	
    54	function validateCanonicalChainIdKey(chainId: string, fieldName: string): void {
    55	  const parsedChainId = Number(chainId);
    56	  if (
    57	    !/^[1-9]\d*$/.test(chainId) ||
    58	    !Number.isInteger(parsedChainId) ||
    59	    parsedChainId <= 0 ||
    60	    String(parsedChainId) !== chainId
    61	  ) {
    62	    throw new Error(
    63	      `${fieldName} entries must use canonical positive integer chain ID keys`
    64	    );
    65	  }
    66	}
    67	
    68	function getChainIdsFromRecord(
    69	  value: unknown,
    70	  fieldName: string,
    71	  required: boolean
    72	): number[] {
    73	  if (value === undefined) {
    74	    if (required) {
    75	      throw new Error(`${fieldName} is required`);
    76	    }
    77	    return [];
    78	  }
    79	  if (!isRecord(value)) {
    80	    throw new Error(`${fieldName} must be an object keyed by chainId`);
    81	  }
    82	  return Object.keys(value)
    83	    .map((chainId) => {
    84	      validateCanonicalChainIdKey(chainId, fieldName);
    85	      return Number(chainId);
    86	    })
    87	    .sort((a, b) => a - b);
    88	}
    89	
    90	function normalizeAddressPolicyByChain(params: {
    91	  value: { [chainId: number]: string[] } | undefined;
    92	  fieldName: string;
    93	  required: boolean;
    94	}): Map<number, string[]> {
    95	  const chainIds = getChainIdsFromRecord(
    96	    params.value,
    97	    params.fieldName,
    98	    params.required
    99	  );
   100	  const normalized = new Map<number, string[]>();
   101	  for (const chainId of chainIds) {
   102	    const addresses = params.value?.[chainId];
   103	    if (!Array.isArray(addresses)) {
   104	      throw new Error(`${params.fieldName}.${chainId} must be non-empty`);
   105	    }
   106	    if (addresses.length > LIFI_CHAIN_POLICY_BOUNDS.maxAllowlistEntries) {
   107	      throw new Error(
   108	        `${params.fieldName}.${chainId} cannot contain more than ${LIFI_CHAIN_POLICY_BOUNDS.maxAllowlistEntries} addresses`
   109	      );
   110	    }
   111	    normalized.set(
   112	      chainId,
   113	      normalizeLifiAddressAllowlist(addresses, {
   114	        label: `${params.fieldName}.${chainId}`,
   115	        requireNonEmpty: true,
   116	      })
   117	    );
   118	  }
   119	  return normalized;
   120	}
   121	
   122	function normalizeSelectorPolicyByChain(params: {
   123	  value: { [chainId: number]: { [callTarget: string]: string[] } } | undefined;
   124	  fieldName: string;
   125	  required: boolean;
   126	  callTargetsByChain?: Map<number, string[]>;
   127	}): Map<number, Record<string, string[]>> {
   128	  const chainIds = getChainIdsFromRecord(
   129	    params.value,
   130	    params.fieldName,
   131	    params.required
   132	  );
   133	  const normalized = new Map<number, Record<string, string[]>>();
   134	  for (const chainId of chainIds) {
   135	    const selectorsByTarget = params.value?.[chainId];
   136	    if (
   137	      selectorsByTarget === undefined ||
   138	      typeof selectorsByTarget !== 'object' ||
   139	      Array.isArray(selectorsByTarget)
   140	    ) {
   141	      throw new Error(
   142	        `${params.fieldName}.${chainId} must be an object keyed by call target`
   143	      );
   144	    }
   145	    const callTargets = params.callTargetsByChain?.get(chainId);
   146	    const normalizedSelectors = normalizeLifiSelectorAllowlistRecord(
   147	      selectorsByTarget,
   148	      {
   149	        label: `${params.fieldName}.${chainId}`,
   150	        requireNonEmpty: true,
   151	        callTargetAllowlist: callTargets,
   152	        requireCallTargetCoverage: callTargets !== undefined,
   153	      }
   154	    );
   155	    for (const [target, selectors] of Object.entries(normalizedSelectors)) {
   156	      if (selectors.length > LIFI_CHAIN_POLICY_BOUNDS.maxSelectorsPerTarget) {
   157	        throw new Error(
   158	          `${params.fieldName}.${chainId}.${target} cannot contain more than ${LIFI_CHAIN_POLICY_BOUNDS.maxSelectorsPerTarget} selectors`
   159	        );
   160	      }
   161	    }
   162	    normalized.set(chainId, normalizedSelectors);
   163	  }
   164	  return normalized;
   165	}
   166	
   167	function ensureRequiredChain(
   168	  value: Map<number, unknown>,
   169	  chainId: number | undefined,
   170	  fieldName: string
   171	): void {
   172	  if (chainId !== undefined && !value.has(chainId)) {
   173	    throw new Error(`${fieldName}.${chainId} is required`);
   174	  }
   175	}
   176	
   177	function normalizeProductionChains(params: {
   178	  config: LifiProductionChainPolicyConfig;
   179	  fieldName: string;
   180	  chainId?: number;
   181	}): NormalizedLifiChainPolicy[] {
   182	  const callTargetsByChain = normalizeAddressPolicyByChain({
   183	    value: params.config.callTargetAllowlist,
   184	    fieldName: `${params.fieldName}.callTargetAllowlist`,
   185	    required: true,
   186	  });
   187	  const approvalSpendersByChain = normalizeAddressPolicyByChain({
   188	    value: params.config.approvalSpenderAllowlist,
   189	    fieldName: `${params.fieldName}.approvalSpenderAllowlist`,
   190	    required: true,
   191	  });
   192	  ensureRequiredChain(
   193	    callTargetsByChain,
   194	    params.chainId,
   195	    `${params.fieldName}.callTargetAllowlist`
   196	  );
   197	  ensureRequiredChain(
   198	    approvalSpendersByChain,
   199	    params.chainId,
   200	    `${params.fieldName}.approvalSpenderAllowlist`
   201	  );
   202	
   203	  for (const configuredChainId of Array.from(callTargetsByChain.keys())) {
   204	    if (!approvalSpendersByChain.has(configuredChainId)) {
   205	      throw new Error(
   206	        `${params.fieldName}.approvalSpenderAllowlist.${configuredChainId} is required`
   207	      );
   208	    }
   209	  }
   210	  for (const configuredChainId of Array.from(approvalSpendersByChain.keys())) {
   211	    if (!callTargetsByChain.has(configuredChainId)) {
   212	      throw new Error(
   213	        `${params.fieldName}.callTargetAllowlist.${configuredChainId} is required`
   214	      );
   215	    }
   216	  }
   217	
   218	  const selectorsByChain = normalizeSelectorPolicyByChain({
   219	    value: params.config.selectorAllowlist,
   220	    fieldName: `${params.fieldName}.selectorAllowlist`,
   221	    required: true,
   222	    callTargetsByChain,
   223	  });
   224	  ensureRequiredChain(
   225	    selectorsByChain,
   226	    params.chainId,
   227	    `${params.fieldName}.selectorAllowlist`
   228	  );
   229	  for (const configuredChainId of Array.from(callTargetsByChain.keys())) {
   230	    if (!selectorsByChain.has(configuredChainId)) {
   231	      throw new Error(
   232	        `${params.fieldName}.selectorAllowlist.${configuredChainId} is required`
   233	      );
   234	    }
   235	  }
   236	
   237	  return Array.from(callTargetsByChain.keys())
   238	    .sort((a, b) => a - b)
   239	    .map((chainId) => ({
   240	      chainId,
   241	      callTargets: callTargetsByChain.get(chainId)!,
   242	      approvalSpenders: approvalSpendersByChain.get(chainId)!,
   243	      selectorAllowlist: selectorsByChain.get(chainId)!,
   244	    }));
   245	}
