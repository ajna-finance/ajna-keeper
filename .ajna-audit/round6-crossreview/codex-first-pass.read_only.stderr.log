   128	      })
   129	      .catch((error) => {
   130	        pendingDecimals.delete(cacheKey);
   131	        throw error;
   132	      });
   133	    pendingDecimals.set(cacheKey, pending);
   134	  }
   135	
   136	  return await pendingDecimals.get(cacheKey)!;
   137	}
