# misc
.DS_Store
# Operator working-config files live at the repo ROOT (see README: `cp
# examples/example-base-config.ts config.ts`). Anchor with a leading slash so
# these patterns do NOT silently swallow source files named config*.ts under
# src/ or scripts/ (e.g. scripts/no-spend/config-smoke.ts was lost this way).
/config*.json
/config*.ts
